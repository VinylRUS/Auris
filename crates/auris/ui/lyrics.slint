// Панель текста песни (справа, вместо очереди).
// Состояния: 0 — ничего не играется, 1 — загрузка, 2 — готово, 3 — текст не найден.
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton } from "widgets.slint";

export component LyricsPanel inherits Rectangle {
    in property <string> title: "";
    in property <string> artists: "";
    in property <int> state: 0;        // 0 пусто, 1 загрузка, 2 готово, 3 нет текста
    in property <string> text: "";
    // Ширина управляется извне (main.slint делает её адаптивной).
    in property <length> panel-width: 380px;
    callback close();

    width: panel-width;
    // Подложка из темы (раньше хардкод rgba(255,255,255,0.015)).
    background: Theme.fill.with-alpha(0.015);
    // левая граница (Slint не умеет бордеры по сторонам)
    Rectangle {
        x: 0;
        width: 1px;
        y: 0;
        height: 100%;
        background: Theme.stroke;
    }

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        spacing: 8px;

        // ---- Шапка ----
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Icon {
                source: Icons.lyrics;
                size: 17px;
                tint: Theme.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Текст песни";
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IconButton {
                source: Icons.close;
                icon-size: 15px;
                clicked => { root.close(); }
            }
        }

        // ---- Трек ----
        Text {
            text: root.title != "" ? root.title : "Ничего не играет";
            font-size: 14px;
            font-weight: 600;
            color: Theme.text-2;
            overflow: elide;
        }
        Text {
            text: root.artists;
            font-size: 12.5px;
            color: Theme.text-3;
            overflow: elide;
            visible: root.artists != "";
        }
        Rectangle { height: 1px; background: Theme.stroke; }

        // ---- Контент ----
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Загрузка
            if root.state == 1: Text {
                text: "Загружаем текст…";
                font-size: 13px;
                color: Theme.text-3;
                x: (parent.width - self.width) / 2;
                y: parent.height / 3;
            }

            // Нет текста
            if root.state == 0 || root.state == 3: VerticalLayout {
                alignment: start;
                padding-top: 24px;
                spacing: 10px;
                Icon {
                    source: Icons.note;
                    size: 30px;
                    tint: Theme.text-3;
                    opacity: 0.6;
                }
                Text {
                    text: root.state == 0 ? "Начните воспроизведение,\nчтобы увидеть текст"
                                          : "Для этого трека текста нет";
                    font-size: 13px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }

            // Готово: прокручиваемый текст
            if root.state == 2: Flickable {
                x: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: lyrics-text.preferred-height + 28px;

                lyrics-text := Text {
                    x: 4px;
                    y: 14px;
                    width: parent.width - 8px;
                    text: root.text;
                    font-size: 15px;
                    color: Theme.text-2;
                    wrap: word-wrap;
                }
            }
        }

        // ---- Подвал ----
        Text {
            text: "Текст · Яндекс.Музыка";
            font-size: 11px;
            color: Theme.text-3;
            opacity: 0.7;
            visible: root.state == 2;
        }
    }
}
