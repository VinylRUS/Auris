// Auris — главное окно.
//
// Архитектура размера окна (ВАЖНО, не ломать):
//  * Явный размер задаётся из Rust через `set_size` (восстановление из
//    конфига, дефолт 1280×800). Без этого окно создаётся по preferred-
//    размеру корневого layout, а на экране входа он пуст → 800×600.
//  * Корневой layout стабилен: TitleBar + один positional Rectangle.
//    Все страницы — position-дети (width/height 100%), они НЕ участвуют
//    в layout-констрейнтах и потому не могут сжать/растянуть окно
//    (раньше страница настроек сжимала окно до 1205px).
import { Theme } from "theme.slint";
import { TitleBar } from "titlebar.slint";
import { SideBar } from "sidebar.slint";
import { PlayerBar } from "playerbar.slint";
import { QueuePanel } from "queue.slint";
import { LyricsPanel } from "lyrics.slint";
import { LoginPage } from "pages/login.slint";
import { HomePage } from "pages/home.slint";
import { SearchPage } from "pages/search.slint";
import { LibraryPage } from "pages/library.slint";
import { WavePage } from "pages/wave.slint";
import { DownloadsPage } from "pages/downloads.slint";
import { RadioPage } from "pages/radio.slint";
import { SettingsPage } from "pages/settings.slint";
import { TileItem, TrackItem, BestItem, StationItem } from "structs.slint";

// Повторно экспортируем глобал темы для доступа из Rust.
export { Theme } from "theme.slint";

export component MainWindow inherits Window {
    title: "Auris";
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    // Стартовый фокус — на горячие клавиши (Space и стрелки работают
    // сразу; в поле поиска фокус уходит только при клике в него).
    forward-focus: hotkeys;

    // ================= Состояние =================
    in-out property <bool> logged-in: false;
    in-out property <int> page: 0;                 // 0 главная, 1 поиск, 2 библиотека,
                                                   // 3 скачанное, 4 волна, 5 настройки, 6 радио
    in-out property <bool> queue-open: true;
    in-out property <bool> win-maximized: false;

    // Адаптивные ширины боковых панелей: доля окна с ограничениями
    // (раньше 300px/380px были жёстко зашиты — на узком окне
    // область контента сжималась агрессивно).
    property <length> queue-panel-w: min(340px, max(248px, root.width * 0.22));
    property <length> lyrics-panel-w: min(430px, max(288px, root.width * 0.3));

    // ---- Пользователь ----
    in-out property <string> user-name: "";
    in-out property <string> user-initial: "";
    in-out property <string> user-login: "";
    in-out property <string> user-plan: "";
    in-out property <bool> has-subscription: false;

    // ---- Логин ----
    in-out property <int> login-state: 0;          // 0 старт, 1 ждём, 2 ошибка
    in-out property <string> login-user-code: "";
    in-out property <string> login-url: "";
    in-out property <image> login-qr-image;
    in-out property <string> login-error: "";
    in-out property <int> login-ttl: -1;           // сек до конца жизни кода, -1 скрыт

    // ---- Поиск ----
    in-out property <bool> searching: false;
    in-out property <bool> has-results: false;
    in-out property <bool> has-best: false;
    in-out property <BestItem> search-best: {
        item-type: 0, title: "", subtitle: "", cover-variant: 1,
        track-id: 0, owner-uid: 0, kind: 0,
    };
    in-out property <[TrackItem]> search-tracks;
    in-out property <int> search-total: 0;
    in-out property <[string]> search-suggestions;

    // ---- Главная ----
    in-out property <string> greeting: "Добрый день";
    in-out property <int> home-chip: 0;
    in-out property <[TileItem]> home-recent;
    in-out property <[TileItem]> home-generated;
    in-out property <[TileItem]> home-playlists;
    in-out property <string> sync-error: "";

    // ---- Библиотека ----
    in-out property <bool> playlist-open: false;
    in-out property <string> playlist-title: "";
    in-out property <string> playlist-subtitle: "";
    in-out property <[TrackItem]> playlist-tracks;
    in-out property <[TileItem]> library-playlists;
    in-out property <[TileItem]> library-albums;
    in-out property <[TileItem]> library-artists;

    // ---- Скачанное ----
    in-out property <[TrackItem]> downloads-items;
    in-out property <string> downloads-dir: "";

    // ---- Волна ----
    in-out property <bool> wave-active: false;
    in-out property <[TrackItem]> wave-upcoming;

    // ---- Радио ----
    in-out property <[StationItem]> radio-stations;

    // ---- Плеер ----
    in-out property <string> cur-title: "";
    in-out property <string> cur-artists: "";
    in-out property <image> cur-cover;
    in-out property <int> cur-cover-variant: 1;
    in-out property <bool> playing: false;
    in-out property <bool> cur-liked: false;
    in-out property <float> position-sec: 0;
    in-out property <float> duration-sec: 0;
    in-out property <float> volume: 0.7;
    in-out property <bool> shuffle: false;
    in-out property <int> repeat: 0;               // 0 выкл, 1 все, 2 один
    in-out property <string> queue-source: "";

    // ---- Очередь ----
    in-out property <[TrackItem]> queue-items;

    // ---- Лирика ----
    in-out property <bool> lyrics-open: false;
    in-out property <int> lyrics-state: 0;      // 0 пусто, 1 загрузка, 2 готово, 3 нет текста
    in-out property <string> lyrics-text: "";

    // ---- Настройки ----
    in-out property <string> settings-preset: "fluent-dark";
    in-out property <string> settings-accent: "";
    in-out property <int> settings-quality: 2;
    in-out property <string> settings-cache-size: "";
    in-out property <string> settings-version: "0.0.1c";
    in-out property <string> settings-storage: "";

    // ---- Обновление ----
    in-out property <int> update-state: 0;   // 0 неизвестно, 1 проверка, 2 актуально,
                                             // 3 доступно, 4 скачивание, 5 ошибка
    in-out property <string> update-version: "";
    in-out property <string> update-notes: "";
    in-out property <float> update-progress: 0;
    in-out property <string> update-error: "";
    in-out property <bool> update-installer: false;   // true на Windows

    // ================= Колбэки в Rust =================
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    callback login-start();
    callback login-open-browser();
    callback login-paste-token(string);
    callback login-cancel();

    callback search(string);
    callback suggest(string);
    callback accept-suggestion(string);
    callback play-from-search(int);
    callback play-best();
    callback search-like-toggled(int);
    callback search-download(int);

    callback chip-clicked(int);
    callback play-wave();
    callback open-tile(TileItem);

    callback playlist-play-all();
    callback playlist-play-index(int);
    callback playlist-like-toggled(int);
    callback playlist-download(int);

    callback wave-start();
    callback wave-toggle-play();
    callback wave-next();
    callback wave-like();
    callback wave-dislike();
    callback wave-play-index(int);
    callback wave-like-toggled(int);

    callback radio-start(string, string);

    callback player-toggle();
    callback player-next();
    callback player-prev();
    callback player-seek(float);
    callback player-set-volume(float);
    callback player-toggle-like();
    callback player-toggle-shuffle();
    callback player-cycle-repeat();

    callback queue-play-index(int);
    callback queue-remove-index(int);

    callback toggle-lyrics();

    callback settings-set-theme(string);
    callback settings-set-accent(string);
    callback settings-pick-dir();
    callback settings-set-quality(int);
    callback settings-clear-cache();
    callback settings-logout();

    callback update-check();
    callback update-install();
    callback update-cancel();

    // ================= Каркас =================
    VerticalLayout {
        // Титлбар — ВСЕГДА (и на экране входа: окно можно закрыть/свернуть).
        TitleBar {
            window-minimize => { root.window-minimize(); }
            window-maximize => { root.window-maximize(); }
            window-close => { root.window-close(); }
            maximized: root.win-maximized;
        }

        // Контент: positional-контейнер. Дети не влияют на констрейнты окна.
        Rectangle {
            vertical-stretch: 1;

            // Горячие клавиши приложения: Space — play/pause, стрелки —
            // перемотка ±5с и громкость ±5%, Escape — закрыть панель/
            // плейлист. Живёт вне условий входа, чтобы фокус был стабилен.
            hotkeys := FocusScope {
                width: 0px; height: 0px;
                // Явно берём фокус при создании: forward-focus окна
                // срабатывает не на всех бэкендах/WM (например, без
                // оконного менеджера событие активации не приходит).
                init => { self.focus(); }
                key-pressed(event) => {
                    if (!root.logged-in) { return reject; }
                    if (event.text == Key.Space) {
                        root.player-toggle();
                        return accept;
                    }
                    if (event.text == Key.RightArrow && root.duration-sec > 0) {
                        root.player-seek(min(0.999, (root.position-sec + 5) / root.duration-sec));
                        return accept;
                    }
                    if (event.text == Key.LeftArrow && root.duration-sec > 0) {
                        root.player-seek(max(0, (root.position-sec - 5) / root.duration-sec));
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.volume = min(1, root.volume + 0.05);
                        root.player-set-volume(root.volume);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.volume = max(0, root.volume - 0.05);
                        root.player-set-volume(root.volume);
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        if (root.lyrics-open) { root.lyrics-open = false; return accept; }
                        if (root.queue-open) { root.queue-open = false; return accept; }
                        if (root.playlist-open) { root.playlist-open = false; return accept; }
                    }
                    return reject;
                }
            }

            // ============= Экран входа =============
            if !root.logged-in: LoginPage {
                width: 100%;
                height: 100%;
                state: root.login-state;
                user-code: root.login-user-code;
                verification-url: root.login-url;
                qr-image: root.login-qr-image;
                error-text: root.login-error;
                ttl-seconds: root.login-ttl;
                start => { root.login-start(); }
                open-browser => { root.login-open-browser(); }
                paste-token(t) => { root.login-paste-token(t); }
                cancel => { root.login-cancel(); }
            }

            // ============= Основное приложение =============
            if root.logged-in: Rectangle {
                width: 100%;
                height: 100%;

                SideBar {
                    x: 0;
                    y: 0;
                    // Выше плавающего плеера: «Настройки» и карточка профиля
                    // не должны уходить под панель воспроизведения.
                    height: parent.height - 104px;
                    // Односторонний биндинг: page у сайдбара — in-свойство,
                    // <=> на in-свойстве вычисляется один раз и не живёт
                    // (см. комментарий у плеер-бара ниже).
                    page: root.page;
                    user-name: root.user-name;
                    user-plan: root.user-plan;
                    user-initial: root.user-initial;
                    navigate(p) => {
                        root.playlist-open = false;
                        root.page = p;
                        // Возвращаем фокус горячим клавишам после навигации.
                        hotkeys.focus();
                    }
                }

                // Область страниц: правее сайдбара, выше плеера, левее очереди/лирики.
                pages-host := Rectangle {
                    x: 264px;
                    y: 0;
                    width: parent.width - self.x
                        - (root.lyrics-open ? root.lyrics-panel-w : (root.queue-open ? root.queue-panel-w : 0px));
                    height: parent.height - 104px;

                    if root.page == 0: HomePage {
                        width: 100%; height: 100%;
                        greeting: root.greeting;
                        chip: root.home-chip;
                        has-subscription: root.has-subscription;
                        recent: root.home-recent;
                        generated: root.home-generated;
                        playlists: root.home-playlists;
                        sync-error: root.sync-error;
                        chip-clicked(c) => { root.chip-clicked(c); }
                        play-wave => { root.play-wave(); }
                        open-tile(t) => { root.open-tile(t); }
                    }
                    if root.page == 1: SearchPage {
                        width: 100%; height: 100%;
                        searching: root.searching;
                        has-results: root.has-results;
                        best: root.search-best;
                        has-best: root.has-best;
                        tracks: root.search-tracks;
                        tracks-total: root.search-total;
                        suggestions: root.search-suggestions;
                        search(t) => { root.search(t); hotkeys.focus(); }
                        suggest(t) => { root.suggest(t); }
                        accept-suggestion(s) => { root.accept-suggestion(s); hotkeys.focus(); }
                        play-best => { root.play-best(); }
                        play-index(i) => { root.play-from-search(i); }
                        like-toggled(i) => { root.search-like-toggled(i); }
                        download-clicked(i) => { root.search-download(i); }
                    }
                    if root.page == 2: LibraryPage {
                        width: 100%; height: 100%;
                        playlists: root.library-playlists;
                        albums: root.library-albums;
                        artists: root.library-artists;
                        playlist-open: root.playlist-open;
                        playlist-title: root.playlist-title;
                        playlist-subtitle: root.playlist-subtitle;
                        playlist-tracks: root.playlist-tracks;
                        open-tile(t) => { root.open-tile(t); }
                        close-playlist => { root.playlist-open = false; }
                        play-all => { root.playlist-play-all(); }
                        play-index(i) => { root.playlist-play-index(i); }
                        like-toggled(i) => { root.playlist-like-toggled(i); }
                        download-clicked(i) => { root.playlist-download(i); }
                    }
                    if root.page == 3: DownloadsPage {
                        width: 100%; height: 100%;
                        items: root.downloads-items;
                        dir-label: root.downloads-dir;
                        has-subscription: root.has-subscription;
                    }
                    if root.page == 4: WavePage {
                        width: 100%; height: 100%;
                        active: root.wave-active;
                        title: root.cur-title;
                        artists: root.cur-artists;
                        cover: root.cur-cover;
                        cover-variant: root.cur-cover-variant;
                        playing: root.playing;
                        // Односторонние биндинги: второй <=> на те же свойства
                        // окна (первый — у плеер-бара) ломал цепочку —
                        // плеер-бар навсегда видел position/duration = 0
                        // (пустой прогресс и «—» вместо таймкодов).
                        position-sec: root.position-sec;
                        duration-sec: root.duration-sec;
                        liked: root.cur-liked;
                        upcoming: root.wave-upcoming;
                        start-wave => { root.wave-start(); }
                        toggle-play => { root.player-toggle(); }
                        next => { root.wave-next(); }
                        like => { root.player-toggle-like(); }
                        dislike => { root.wave-dislike(); }
                        play-index(i) => { root.wave-play-index(i); }
                        like-toggled(i) => { root.wave-like-toggled(i); }
                    }
                    if root.page == 5: SettingsPage {
                        width: 100%; height: 100%;
                        preset: root.settings-preset;
                        accent-custom: root.settings-accent;
                        quality: root.settings-quality;
                        downloads-dir: root.downloads-dir;
                        cache-size: root.settings-cache-size;
                        user-name: root.user-name;
                        user-login: root.user-login;
                        user-plan: root.user-plan;
                        version: root.settings-version;
                        storage-kind: root.settings-storage;
                        set-theme(t) => { root.settings-set-theme(t); }
                        set-accent(a) => { root.settings-set-accent(a); }
                        pick-downloads-dir => { root.settings-pick-dir(); }
                        set-quality(q) => { root.settings-set-quality(q); }
                        clear-cache => { root.settings-clear-cache(); }
                        logout => { root.settings-logout(); }
                        update-state: root.update-state;
                        update-version: root.update-version;
                        update-notes: root.update-notes;
                        update-progress: root.update-progress;
                        update-error: root.update-error;
                        update-installer: root.update-installer;
                        check-update => { root.update-check(); }
                        install-update => { root.update-install(); }
                        cancel-update => { root.update-cancel(); }
                    }
                    if root.page == 6: RadioPage {
                        width: 100%; height: 100%;
                        stations: root.radio-stations;
                        start-station(seed, name) => { root.radio-start(seed, name); }
                    }
                }

                // Панель очереди — справа (уступает место панели лирики).
                if root.queue-open && !root.lyrics-open: QueuePanel {
                    x: parent.width - self.width;
                    y: 0;
                    height: parent.height - 104px;
                    panel-width: root.queue-panel-w;
                    items: root.queue-items;
                    source-label: root.queue-source;
                    play-index(i) => { root.queue-play-index(i); }
                    remove-index(i) => { root.queue-remove-index(i); }
                    close => { root.queue-open = false; }
                }

                // Панель текста песни — справа, вместо очереди.
                if root.lyrics-open: LyricsPanel {
                    x: parent.width - self.width;
                    y: 0;
                    height: parent.height - 104px;
                    panel-width: root.lyrics-panel-w;
                    title: root.cur-title;
                    artists: root.cur-artists;
                    state: root.lyrics-state;
                    text: root.lyrics-text;
                    close => { root.lyrics-open = false; }
                }

                // Плавающий плеер-бар (с запасом под тень).
                PlayerBar {
                    x: 14px;
                    y: parent.height - 100px;
                    width: parent.width - 28px;
                    title: root.cur-title;
                    artists: root.cur-artists;
                    cover: root.cur-cover;
                    cover-variant: root.cur-cover-variant;
                    playing: root.playing;
                    liked: root.cur-liked;
                    // ВАЖНО: у плеер-бара только volume — настоящий in-out
                    // (бар пишет его при mute). Остальные его свойства — in,
                    // и <=> на них не обновлялся после старта: прогресс
                    // оставался пустым, таймкоды — «—», shuffle/repeat/
                    // queue-open не реагировали. Поэтому — односторонние
                    // биндинги; изменения идут через колбэки → Rust →
                    // свойства окна.
                    position-sec: root.position-sec;
                    duration-sec: root.duration-sec;
                    volume <=> root.volume;
                    shuffle: root.shuffle;
                    repeat: root.repeat;
                    queue-open: root.queue-open;
                    lyrics-open: root.lyrics-open;
                    toggle-play => { root.player-toggle(); }
                    next => { root.player-next(); }
                    prev => { root.player-prev(); }
                    seek(f) => { root.player-seek(f); }
                    set-volume(v) => { root.player-set-volume(v); }
                    toggle-like => { root.player-toggle-like(); }
                    toggle-shuffle => { root.player-toggle-shuffle(); }
                    cycle-repeat => { root.player-cycle-repeat(); }
                    toggle-queue => {
                        root.queue-open = !root.queue-open;
                        if (root.queue-open) { root.lyrics-open = false; }
                    }
                    toggle-lyrics => {
                        // Состоянием владеет Rust (единая точка тоггла).
                        root.toggle-lyrics();
                    }
                }
            }
        }
    }
}
