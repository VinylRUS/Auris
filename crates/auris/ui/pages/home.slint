// Главная: волна-хиро, чипы, «недавно», «собрано для вас», плейлисты.
import { Theme } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { ActionButton, Chip, SectionHead, TileGrid } from "../widgets.slint";
import { TileItem } from "../structs.slint";

export component HomePage inherits Rectangle {
    in property <string> greeting: "Добрый вечер";
    in property <int> chip: 0;              // 0 недавно, 1 новинки, 2 чарт
    in property <bool> has-subscription: false;
    in property <[TileItem]> recent;
    in property <[TileItem]> generated;
    in property <[TileItem]> playlists;
    in property <string> sync-error: "";   // ошибка загрузки (пусто — скрыт)

    callback chip-clicked(int);
    callback play-wave();
    callback open-tile(TileItem);

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-top: 14px;
        padding-right: 24px;
        spacing: 0px;

        // Обёртка-паттерн из std-widgets ScrollView: Flickable с явным
        // width/height от родителя — иначе ширина = preferred контента.
        Rectangle {
            vertical-stretch: 1;

            Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;   // разрывает цикл min-width (дефолт смотрит на детей)
                vertical-stretch: 1;
            // Хром страницы: шапка(44) + хиро(152) + чипы(34) + 3 заголовка секций(24+10)
            // + шпации + хвост. Высоты сеток считаются динамически (tile-grid).
            content-height: 96px + 152px + 34px
                + 34px + recent-grid.height + (root.recent.length == 0 ? 18px : 0px)
                + (root.generated.length > 0 ? 34px + generated-grid.height : 0px)
                + 34px + playlists-grid.height + (root.playlists.length == 0 ? 18px : 0px)
                + 24px;

            VerticalLayout {
                alignment: start;
                spacing: 16px;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.greeting;
                        font-size: 24px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: "Что послушаем сегодня?";
                        font-size: 13px;
                        color: Theme.text-3;
                    }
                }

                // ---- Hero: Моя волна ----
                Rectangle {
                    height: 152px;
                    border-radius: Theme.r-card;
                    clip: true;
                    background: @linear-gradient(105deg, Theme.accent-fill, #20202000 55%);

                    // Декоративные волны (медленно «дышат»)
                    Path {
                        property <length> dx: 0px;
                        init => { dx = 34px; }
                        x: parent.width - 400px + self.dx;
                        y: (parent.height - 100px) / 2;
                        width: 380px; height: 100px;
                        viewbox-width: 380; viewbox-height: 100;
                        stroke: Theme.accent;
                        stroke-width: 1.6px;
                        fill: transparent;
                        opacity: 0.6;
                        animate dx { duration: 5200ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
                        commands: "M 0 62 Q 33 16 66 62 T 132 62 T 198 62 T 264 62 T 330 62 T 396 62";
                    }
                    Path {
                        property <length> dx: 34px;
                        init => { dx = 0px; }
                        x: parent.width - 400px + self.dx;
                        y: (parent.height - 100px) / 2;
                        width: 380px; height: 100px;
                        viewbox-width: 380; viewbox-height: 100;
                        stroke: Theme.accent;
                        stroke-width: 1.6px;
                        fill: transparent;
                        opacity: 0.35;
                        animate dx { duration: 6400ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
                        commands: "M 0 78 Q 33 40 66 78 T 132 78 T 198 78 T 264 78 T 330 78 T 396 78";
                    }

                    VerticalLayout {
                        padding: 26px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "ПЕРСОНАЛЬНЫЙ ПОТОК";
                            font-size: 11.5px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                            color: Theme.accent;
                        }
                        Text {
                            text: "Моя волна";
                            font-size: 26px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "Бесконечный микс из любимых треков и новых открытий";
                            font-size: 13px;
                            color: Theme.text-2;
                        }
                        Rectangle { height: 8px; }
                        ActionButton {
                            label: "Слушать";
                            icon: Icons.play;
                            accent: true;
                            height: 34px;
                            width: 132px;
                            clicked => { root.play-wave(); }
                        }
                    }
                }

                // ---- Баннер ошибки загрузки ----
                if root.sync-error != "": Rectangle {
                    height: 44px;
                    border-radius: Theme.r-card;
                    background: Theme.fill;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        alignment: start;
                        Icon {
                            source: Icons.error;
                            size: 16px;
                            tint: Theme.accent;
                        }
                        Text {
                            text: root.sync-error;
                            font-size: 12.5px;
                            color: Theme.text-2;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // ---- Чипы ----
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Chip { label: "Недавно"; active: root.chip == 0; clicked => { root.chip-clicked(0); } }
                    Chip { label: "Новинки"; active: root.chip == 1; clicked => { root.chip-clicked(1); } }
                    Chip { label: "Чарт"; active: root.chip == 2; clicked => { root.chip-clicked(2); } }
                }

                // ---- Недавно слушали (история) ----
                VerticalLayout {
                    spacing: 10px;
                    SectionHead {
                        title: "Недавно слушали";
                        link-text: root.recent.length > 0 ? "Очистить" : "";
                        link-clicked => { }
                    }
                    if root.recent.length == 0: Text {
                        text: "Здесь появится история прослушиваний";
                        font-size: 13px;
                        color: Theme.text-3;
                    }
                }
                recent-grid := TileGrid {
                    items: root.recent;
                    target-size: 168px;
                    tile-clicked(t) => { root.open-tile(t); }
                }

                // ---- Собрано для вас (лента) ----
                if root.generated.length > 0: SectionHead {
                    title: "Собрано для вас";
                }
                generated-grid := TileGrid {
                    items: root.generated;
                    target-size: 168px;
                    tile-clicked(t) => { root.open-tile(t); }
                }

                // ---- Ваши плейлисты ----
                VerticalLayout {
                    spacing: 10px;
                    SectionHead {
                        title: "Ваши плейлисты";
                    }
                    if root.playlists.length == 0: Text {
                        text: "Плейлисты появятся после первого входа";
                        font-size: 13px;
                        color: Theme.text-3;
                    }
                }
                playlists-grid := TileGrid {
                    items: root.playlists;
                    target-size: 168px;
                    tile-clicked(t) => { root.open-tile(t); }
                }

                Rectangle { height: 8px; }
            }
            }
        }
    }
}
