// Библиотека: сетка плейлистов + открытый плейлист (таблица треков).
import { Theme } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { ActionButton, IconButton, SectionHead, TileGrid, TrackRow } from "../widgets.slint";
import { TileItem, TrackItem } from "../structs.slint";

export component LibraryPage inherits Rectangle {
    in property <[TileItem]> playlists;
    in property <bool> playlist-open: false;
    in property <string> playlist-title: "";
    in property <string> playlist-subtitle: "";
    in property <[TrackItem]> playlist-tracks;
    // Высота сетки плейлистов — публикуется из условия (для Flickable).
    property <length> grid-h: 0px;

    callback open-tile(TileItem);
    callback close-playlist();
    callback play-all();
    callback play-index(int);
    callback like-toggled(int);
    callback download-clicked(int);

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-top: 14px;
        padding-right: 24px;

        Rectangle {
            vertical-stretch: 1;

            Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;   // разрывает цикл min-width (дефолт смотрит на детей)
            content-height: root.playlist-open
                ? 150px + 52px * root.playlist-tracks.length
                : 118px + root.grid-h;

            VerticalLayout {
                alignment: start;
                // ---- Открытый плейлист ----
                if root.playlist-open: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        IconButton {
                            source: Icons.arrow-left;
                            size: 36px;
                            icon-size: 18px;
                            y: 2px;
                            clicked => { root.close-playlist(); }
                        }
                        Text {
                            text: root.playlist-title;
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: root.playlist-subtitle;
                        font-size: 13px;
                        color: Theme.text-3;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton {
                            label: "Слушать";
                            icon: Icons.play;
                            accent: true;
                            clicked => { root.play-all(); }
                        }
                    }
                    Rectangle { height: 4px; }
                    for item[i] in root.playlist-tracks: TrackRow {
                        index: i + 1;
                        title: item.title;
                        artists: item.artists;
                        album: item.album;
                        duration-sec: item.duration-sec;
                        cover-image: item.cover;
                        cover-variant: item.cover-variant;
                        liked: item.liked;
                        is-current: item.is-current;
                        is-playing: item.is-playing;
                        dl-state: item.dl-state;
                        clicked => { root.play-index(i); }
                        like-toggled => { root.like-toggled(i); }
                        download-clicked => { root.download-clicked(i); }
                    }
                    Rectangle { height: 12px; }
                }

                // ---- Сетка плейлистов ----
                if !root.playlist-open: VerticalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Библиотека";
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: "Ваши плейлисты и любимые треки";
                            font-size: 13px;
                            color: Theme.text-3;
                        }
                    }

                    library-grid := TileGrid {
                        items: root.playlists;
                        target-size: 172px;
                        tile-clicked(t) => { root.open-tile(t); }
                        changed height => { root.grid-h = self.height; }
                    }

                    if root.playlists.length == 0: Text {
                        text: "Пока пусто — плейлисты подгрузятся после входа";
                        font-size: 13px;
                        color: Theme.text-3;
                    }
                    Rectangle { height: 12px; }
                }
            }
                    }
        }
    }
}
