// Экран входа: бренд-панель + карточка авторизации (QR / код / токен).
//
// Вдохновлён экранами входа Spotify и Яндекс.Музыки: слева — бренд
// с анимированной волной, справа — карточка с QR-кодом и кодом
// подтверждения. Пароль приложение не запрашивает никогда.
import { Theme } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { ActionButton } from "../widgets.slint";

// Крутящийся спиннер: кольцо + орбитальная точка.
component Spinner inherits Rectangle {
    in property <color> tint: Theme.text-3;
    in property <length> size: 22px;

    width: root.size;
    height: root.size;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.size / 2;
        border-width: 2px;
        border-color: Theme.stroke-strong;
    }
    orbit := Rectangle {
        width: 100%;
        height: 100%;
        property <bool> running: false;
        init => { running = true; }
        transform-rotation: running ? 360deg : 0deg;
        transform-origin: { x: root.size / 2, y: root.size / 2 };
        animate transform-rotation {
            duration: 900ms;
            iteration-count: -1;
            easing: linear;
        }
        Rectangle {
            width: root.size * 0.26;
            height: root.size * 0.26;
            x: (parent.width - self.width) / 2;
            y: 0;
            border-radius: root.size * 0.13;
            background: root.tint;
        }
    }
}

// Строка-подсказка под заголовком.
component StepHint inherits Text {
    font-size: 13px;
    color: Theme.text-3;
    horizontal-alignment: center;
    wrap: word-wrap;
}

// Пунктик «фичи» на бренд-панели.
component FeatureRow inherits HorizontalLayout {
    in property <string> label: "";
    spacing: 12px;
    alignment: start;

    Rectangle {
        width: 26px; height: 26px;
        border-radius: 13px;
        background: Theme.accent-fill;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: Icons.check;
            size: 13px;
            tint: Theme.accent;
        }
    }
    Text {
        text: root.label;
        font-size: 13.5px;
        color: Theme.text-2;
        vertical-alignment: center;
    }
}

// Колышущийся столбик волны.
component WaveBar inherits Rectangle {
    in property <length> lo: 12px;
    in property <length> hi: 30px;
    in property <duration> dur: 1100ms;
    in property <duration> del: 0ms;
    width: 5px;
    border-radius: 2.5px;
    background: #804CC2FF;

    property <bool> running: false;
    init => { running = true; }
    height: running ? hi : lo;
    animate height {
        duration: dur;
        delay: del;
        iteration-count: -1;
        direction: alternate;
        easing: ease-in-out;
    }
}

export component LoginPage inherits Rectangle {
    // 0 — старт, 1 — ждём подтверждения, 2 — ошибка
    in property <int> state: 0;
    in property <string> user-code: "";
    in property <string> verification-url: "";
    in property <image> qr-image;
    in property <string> error-text: "";
    // Сколько секунд код ещё действителен; -1 — не показывать.
    in property <int> ttl-seconds: -1;

    // «4:58» — человекочитаемый остаток времени.
    property <string> ttl-text: {
        root.ttl-seconds < 0 ? "" :
        "Код действителен ещё "
        + (root.ttl-seconds / 60)
        + ":"
        + (Math.mod(root.ttl-seconds, 60) < 10 ? "0" : "")
        + Math.mod(root.ttl-seconds, 60)
    }

    callback start();
    callback open-browser();
    callback paste-token(string);
    callback cancel();

    background: #14161B;

    // ===================== Левая бренд-панель =====================
    // Позиционная геометрия (как у всего каркаса приложения):
    // layout-ребёнок компонента с внешним width-биндингом упорно
    // решался по preferred-ширине (~920px) и оставлял 360px пустоты
    // справа. Явные x/width гарантируют заполнение окна.
    Rectangle {
        x: 0;
        width: parent.width - 460px;
        height: 100%;
        background: @linear-gradient(150deg, #171A21 0%, #14161B 70%);
        clip: true;

            // Декоративное свечение (размытые пятна акцента)
            Rectangle {
                x: parent.width * 0.20 - 260px;
                y: parent.height * 0.18 - 220px;
                width: 520px; height: 440px;
                border-radius: 999px;
                background: @radial-gradient(circle, #330067C0, transparent 65%);
                opacity: 0.5;
            }
            Rectangle {
                x: parent.width * 0.60 - 180px;
                y: parent.height * 0.70 - 180px;
                width: 360px; height: 360px;
                border-radius: 999px;
                background: @radial-gradient(circle, #264CC2FF, transparent 62%);
                opacity: 0.25;
            }

            VerticalLayout {
                alignment: center;
                padding: 64px;
                spacing: 0;

                // Логотип: скруглённый квадрат с эквалайзером
                Rectangle {
                    width: 84px; height: 84px;
                    border-radius: 24px;
                    background: @linear-gradient(135deg, Theme.accent-deep, Theme.accent);
                    drop-shadow-blur: 28px;
                    drop-shadow-offset-y: 10px;
                    drop-shadow-color: #590067C0;

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: Icons.eq;
                        size: 44px;
                        tint: Theme.text-on-accent;
                    }
                }

                Rectangle { height: 26px; }

                Text {
                    text: "Auris";
                    font-size: 40px;
                    font-weight: 800;
                    color: Theme.text;
                    letter-spacing: 0.5px;
                }
                Text {
                    text: "Нативный клиент Яндекс.Музыки";
                    font-size: 14.5px;
                    color: Theme.text-3;
                }

                Rectangle { height: 36px; }

                Text {
                    text: "Музыка без компромиссов";
                    font-size: 19px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: "Лёгкий и быстрый. Без браузера, без Electron.";
                    font-size: 13.5px;
                    color: Theme.text-3;
                }

                Rectangle { height: 30px; }

                VerticalLayout {
                    alignment: LayoutAlignment.start;
                    spacing: 14px;
                    FeatureRow { label: "«Моя волна», поиск и плейлисты"; }
                    FeatureRow { label: "Скачивание треков для офлайна"; }
                    FeatureRow { label: "Тёмная и светлая темы, акценты"; }
                }
            }

            // Анимированная волна внизу панели
            HorizontalLayout {
                y: parent.height - 74px;
                width: 100%;
                height: 74px;
                opacity: 0.45;
                alignment: LayoutAlignment.start;
                padding-left: 64px;

                WaveBar { y: (parent.height - self.height) / 2; lo: 12px; hi: 34px; dur: 1150ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 30px; hi: 14px; dur: 900ms;  del: 120ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 18px; hi: 40px; dur: 1250ms; del: 240ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 38px; hi: 16px; dur: 950ms;  del: 60ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 14px; hi: 30px; dur: 1100ms; del: 300ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 26px; hi: 10px; dur: 880ms;  del: 180ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 10px; hi: 28px; dur: 1200ms; del: 90ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 32px; hi: 14px; dur: 1000ms; del: 260ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 16px; hi: 36px; dur: 1180ms; del: 40ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 24px; hi: 12px; dur: 920ms;  del: 200ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 12px; hi: 32px; dur: 1120ms; del: 150ms; }
                WaveBar { y: (parent.height - self.height) / 2; lo: 28px; hi: 18px; dur: 1040ms; del: 70ms; }
            }
        }

        // ===================== Правая карточка входа =====================
        Rectangle {
            x: parent.width - 460px;
            width: 460px;
            height: 100%;
            background: #191C22;

            VerticalLayout {
                alignment: center;
                padding: 44px;
                spacing: 0;

                Text {
                    text: root.state == 1 ? "Подтвердите вход" : "Вход в Auris";
                    font-size: 21px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                StepHint {
                    text: root.state == 1
                        ? "Отсканируйте QR камерой телефона или введите код"
                        : "Войдите через Яндекс ID — по коду, без пароля";
                }

                Rectangle { height: 30px; }

                // ---------- Состояние: старт ----------
                if root.state == 0: VerticalLayout {
                    alignment: center;
                    spacing: 14px;

                    ActionButton {
                        label: "Войти через Яндекс ID";
                        icon: Icons.chevron-right;
                        accent: true;
                        height: 46px;
                        clicked => { root.start(); }
                    }
                    StepHint {
                        text: "Приложение покажет код — введите его на ya.ru/device\nи подтвердите вход в своём аккаунте.";
                    }
                }

                // ---------- Состояние: ждём подтверждения ----------
                if root.state == 1: VerticalLayout {
                    alignment: center;
                    spacing: 12px;

                    // QR в белой карточке
                    Rectangle {
                        width: 208px; height: 208px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 14px;
                        background: #FFFFFF;
                        drop-shadow-blur: 22px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #50000000;

                        if root.qr-image.width > 0: Image {
                            source: root.qr-image;
                            width: 184px; height: 184px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                        }
                        if root.qr-image.width == 0: Spinner {
                            size: 36px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // Код подтверждения
                    Text {
                        text: root.user-code;
                        font-size: 30px;
                        font-weight: 800;
                        letter-spacing: 5px;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }

                    // Аккуратная «таблетка» с адресом страницы
                    Rectangle {
                        height: 30px;
                        width: 150px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 15px;
                        background: Theme.fill;

                        Text {
                            text: "ya.ru/device";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Сколько времени есть на подтверждение
                    if root.ttl-seconds >= 0: Text {
                        text: root.ttl-text;
                        font-size: 12px;
                        color: Theme.text-3;
                        horizontal-alignment: center;
                    }

                    ActionButton {
                        label: "Открыть страницу входа";
                        icon: Icons.external;
                        accent: true;
                        height: 44px;
                        clicked => { root.open-browser(); }
                    }

                    // Ожидание
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        height: 30px;
                        Spinner { size: 16px; y: (parent.height - self.height) / 2; }
                        Text {
                            text: "Ожидаем подтверждение…";
                            font-size: 12.5px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }

                    // Текстовая кнопка «Отменить»
                    cancel-btn := Rectangle {
                        height: 30px;
                        width: 170px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 6px;
                        background: ta.has-hover ? Theme.fill : transparent;
                        ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.cancel(); }
                        }
                        Text {
                            text: "Отменить и вернуться";
                            font-size: 12.5px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                // ---------- Состояние: ошибка ----------
                if root.state == 2: VerticalLayout {
                    alignment: center;
                    spacing: 14px;

                    Rectangle {
                        width: 64px; height: 64px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 32px;
                        background: #33E5484D;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: Icons.error;
                            size: 30px;
                            tint: #E5484D;
                        }
                    }
                    Text {
                        text: "Не удалось войти";
                        font-size: 15.5px;
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.error-text;
                        font-size: 12.5px;
                        color: Theme.text-3;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        max-height: 72px;
                        overflow: elide;
                    }
                    ActionButton {
                        label: "Повторить";
                        icon: Icons.chevron-right;
                        accent: true;
                        height: 44px;
                        clicked => { root.start(); }
                    }
                }

                Rectangle { height: 26px; }

                // ---------- Резервный вход (вставка токена) ----------
                Rectangle {
                    height: 1px;
                    background: Theme.stroke;
                }
                Rectangle { height: 14px; }
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.fill;
                    border-width: 1px;
                    border-color: Theme.stroke;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Icon {
                            source: Icons.key;
                            size: 15px;
                            tint: Theme.text-3;
                            y: (parent.height - self.height) / 2;
                        }
                        token-input := TextInput {
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 40px;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            accepted => {
                                if (self.text != "") { root.paste-token(self.text); }
                            }
                        }
                    }
                }
                StepHint {
                    text: "Резервный вход: вставьте OAuth-токен и нажмите Enter";
                    font-size: 11.5px;
                }
            }
        }
}
