// Экран входа: QR + код подтверждения + ручная вставка токена.
import { Theme } from "../theme.slint";
import { ActionButton, Icon, SearchField } from "../widgets.slint";

export component LoginPage inherits Rectangle {
    // 0 — старт, 1 — ждём подтверждения, 2 — ошибка
    in property <int> state: 0;
    in property <string> user-code: "";
    in property <string> verification-url: "";
    in property <image> qr-image;
    in property <string> error-text: "";

    callback start();
    callback open-browser();
    callback paste-token(string);

    background: Theme.bg;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 460px;
                height: 560px;
                border-radius: Theme.r-card;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.stroke;

                VerticalLayout {
                    alignment: center;
                    padding: 36px;
                    spacing: 14px;

                    // Логотип
                    Rectangle {
                        width: 64px; height: 64px;
                        border-radius: 18px;
                        background: @linear-gradient(135deg, Theme.accent-deep, Theme.accent);
                        Icon {
                            text: "\u{266B}";
                            font-size: 30px;
                            color: Theme.text-on-accent;
                        }
                    }
                    Text {
                        text: "Auris";
                        font-size: 26px;
                        font-weight: 700;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Клиент Яндекс.Музыки";
                        font-size: 13px;
                        color: Theme.text-3;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: 8px; }

                    if root.state == 0: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: "Войдите через Яндекс ID";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Приложение откроет код подтверждения —\nвведите его на странице ya.ru/device.";
                            font-size: 12.5px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 6px; }
                        ActionButton {
                            label: "Получить код";
                            accent: true;
                            primary-glyph: false;
                            width: 220px;
                            x: (parent.width - self.width) / 2;
                            clicked => { root.start(); }
                        }
                        Text {
                            text: "Пароль приложение не запрашивает никогда.";
                            font-size: 11.5px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                    }

                    if root.state == 1: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: "Отсканируйте QR или введите код";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        // QR-код
                        Rectangle {
                            width: 190px; height: 190px;
                            x: (parent.width - self.width) / 2;
                            border-radius: 8px;
                            background: #FFFFFF;
                            if root.qr-image.width > 0: Image {
                                source: root.qr-image;
                                width: 170px; height: 170px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: root.user-code;
                            font-size: 24px;
                            font-weight: 700;
                            letter-spacing: 2px;
                            color: Theme.accent;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.verification-url;
                            font-size: 12px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        ActionButton {
                            label: "Открыть в браузере";
                            accent: true;
                            primary-glyph: false;
                            width: 220px;
                            x: (parent.width - self.width) / 2;
                            clicked => { root.open-browser(); }
                        }
                        Text {
                            text: "Ожидаем подтверждение…";
                            font-size: 12px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                    }

                    if root.state == 2: VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: "Не удалось войти";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.error-text;
                            font-size: 12.5px;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        ActionButton {
                            label: "Повторить";
                            accent: true;
                            primary-glyph: false;
                            width: 220px;
                            x: (parent.width - self.width) / 2;
                            clicked => { root.start(); }
                        }
                    }

                    Rectangle { height: 4px; }

                    // Аварийный вход: вставка токена
                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Резервный вход: вставьте OAuth-токен";
                            font-size: 11.5px;
                            color: Theme.text-3;
                        }
                        SearchField {
                            placeholder: "y0_…";
                            accepted(t) => { root.paste-token(t); }
                        }
                    }
                }
            }
        }
    }
}
