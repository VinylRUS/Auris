// Радио: станции по жанрам (сиды нового Session API).
import { Theme } from "../theme.slint";
import { Chip } from "../widgets.slint";

export component RadioPage inherits Rectangle {
    callback start-station(string, string);   // (seed, название)

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-top: 14px;
        padding-right: 24px;
        spacing: 14px;

        Text {
            text: "Радио";
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: "Бесконечные станции по жанрам и настроению";
            font-size: 13px;
            color: Theme.text-3;
        }

        Flickable {
            vertical-stretch: 1;
            content-height: 430px;

            VerticalLayout {
                alignment: start;
                spacing: 18px;

                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "ЖАНРЫ";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-3;
                        letter-spacing: 0.8px;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Chip { label: "Рок"; clicked => { root.start-station("genre:rock", "Рок"); } }
                        Chip { label: "Поп"; clicked => { root.start-station("genre:pop", "Поп"); } }
                        Chip { label: "Хип-хоп"; clicked => { root.start-station("genre:hiphop", "Хип-хоп"); } }
                        Chip { label: "Электроника"; clicked => { root.start-station("genre:electronic", "Электроника"); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Chip { label: "Джаз"; clicked => { root.start-station("genre:jazz", "Джаз"); } }
                        Chip { label: "Классика"; clicked => { root.start-station("genre:classical", "Классика"); } }
                        Chip { label: "Метал"; clicked => { root.start-station("genre:metal", "Метал"); } }
                        Chip { label: "Инди"; clicked => { root.start-station("genre:indie", "Инди"); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Chip { label: "Шансон"; clicked => { root.start-station("genre:chanson", "Шансон"); } }
                        Chip { label: "Рэп"; clicked => { root.start-station("genre:rap", "Рэп"); } }
                        Chip { label: "Регги"; clicked => { root.start-station("genre:reggae", "Регги"); } }
                        Chip { label: "Блюз"; clicked => { root.start-station("genre:blues", "Блюз"); } }
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "НАСТРОЕНИЕ";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-3;
                        letter-spacing: 0.8px;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Chip { label: "Бодрое"; clicked => { root.start-station("activity:work-morning", "Утро и работа"); } }
                        Chip { label: "Для фокуса"; clicked => { root.start-station("activity:to-study", "Для учёбы"); } }
                        Chip { label: "Для дороги"; clicked => { root.start-station("activity:to-drive", "В дороге"); } }
                        Chip { label: "Для сна"; clicked => { root.start-station("activity:to-sleep", "Перед сном"); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Chip { label: "Тренировка"; clicked => { root.start-station("activity:sport", "Спорт"); } }
                        Chip { label: "Вечеринка"; clicked => { root.start-station("activity:party", "Вечеринка"); } }
                    }
                }

                Rectangle { height: 8px; }
            }
        }
    }
}
