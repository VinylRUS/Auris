// Настройки: внешний вид (темы + акцент), загрузки, аккаунт, о программе.
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { ActionButton } from "../widgets.slint";

component ThemePreview inherits Rectangle {
    // Мини-превью темы: сайдбар + карточки + плеер
    in property <color> p-bg;
    in property <color> p-side;
    in property <color> p-card;
    in property <color> p-accent;
    in property <bool> light: false;

    width: 132px;
    height: 78px;
    border-radius: 5px;
    background: p-bg;
    clip: true;

    Rectangle {
        x: 0; y: 0;
        width: 44px; height: 100%;
        background: p-side;
        Rectangle {
            x: 6px; y: 10px;
            width: 32px; height: 8px;
            border-radius: 2px;
            background: root.p-accent;
            opacity: 0.9;
        }
        Rectangle {
            x: 6px; y: 24px;
            width: 24px; height: 5px;
            border-radius: 2px;
            background: root.light ? rgba(0,0,0,0.25) : rgba(255,255,255,0.35);
        }
        Rectangle {
            x: 6px; y: 33px;
            width: 28px; height: 5px;
            border-radius: 2px;
            background: root.light ? rgba(0,0,0,0.15) : rgba(255,255,255,0.2);
        }
    }
    Rectangle {
        x: 52px; y: 10px;
        width: 42px; height: 34px;
        border-radius: 3px;
        background: p-card;
        border-width: 1px;
        border-color: root.light ? rgba(0,0,0,0.10) : rgba(255,255,255,0.12);
    }
    Rectangle {
        x: 100px; y: 10px;
        width: 26px; height: 34px;
        border-radius: 3px;
        background: p-card;
        border-width: 1px;
        border-color: root.light ? rgba(0,0,0,0.10) : rgba(255,255,255,0.12);
    }
    Rectangle {
        x: 8px; y: 58px;
        width: 116px; height: 14px;
        border-radius: 4px;
        background: p-card;
        border-width: 1px;
        border-color: root.light ? rgba(0,0,0,0.10) : rgba(255,255,255,0.12);
        Rectangle {
            x: 2px; y: 4px;
            width: 22px; height: 6px;
            border-radius: 2px;
            background: root.p-accent;
        }
    }
}

component ThemeCard inherits Rectangle {
    in property <string> title;
    in property <color> p-bg;
    in property <color> p-side;
    in property <color> p-card;
    in property <color> p-accent;
    in property <bool> light: false;
    in property <bool> active: false;
    callback clicked;

    width: 148px;
    height: 132px;
    border-radius: Theme.r-card;
    border-width: active ? 2px : 1px;
    border-color: active ? Theme.accent : (ta.has-hover ? Theme.stroke-strong : Theme.stroke);
    background: active ? Theme.accent-fill : (ta.has-hover ? Theme.fill : transparent);
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    VerticalLayout {
        padding: 8px;
        ThemePreview {
            p-bg: root.p-bg;
            p-side: root.p-side;
            p-card: root.p-card;
            p-accent: root.p-accent;
            light: root.light;
        }
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: root.active ? 700 : 400;
            color: root.active ? Theme.text-on-accent-fill : Theme.text-2;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AccentSwatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> active: false;
    callback clicked;

    width: 28px; height: 28px;
    border-radius: 14px;
    background: swatch;
    transform-scale-x: ta.has-hover && !active ? 115% : 100%;
    transform-scale-y: ta.has-hover && !active ? 115% : 100%;
    animate transform-scale-x { duration: 110ms; easing: ease-out; }
    animate transform-scale-y { duration: 110ms; easing: ease-out; }

    if active: Rectangle {
        x: -5px + (parent.width - self.width) / 2;
        y: -5px + (parent.height - self.height) / 2;
        width: 36px; height: 36px;
        border-radius: 18px;
        border-width: 2px;
        border-color: Theme.accent;
        background: transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> title;

    border-radius: Theme.r-card;
    background: rgba(255, 255, 255, 0.028);
    border-width: 1px;
    border-color: Theme.stroke;

    VerticalLayout {
        padding: 18px;
        padding-right: 20px;
        padding-left: 20px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 6px;

        Text {
            text: root.title;
            font-size: 14.5px;
            font-weight: 700;
            color: Theme.text;
        }
        @children
    }
}

export component SettingsPage inherits Rectangle {
    in property <string> preset: "fluent-dark";
    in property <string> accent-custom: "";
    in property <int> quality: 2;             // 0 low, 1 normal, 2 high
    in property <string> downloads-dir: "";
    in property <string> cache-size: "";
    in property <string> user-name: "";
    in property <string> user-login: "";
    in property <string> user-plan: "";
    in property <string> version: "";
    in property <string> storage-kind: "";

    // Обновление: 0 неизвестно, 1 проверка, 2 актуально,
    // 3 доступно, 4 скачивание, 5 ошибка
    in property <int> update-state: 0;
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <float> update-progress: 0;
    in property <string> update-error: "";
    in property <bool> update-installer: false;

    callback set-theme(string);
    callback set-accent(string);              // "" = сброс на пресет
    callback pick-downloads-dir();
    callback set-quality(int);
    callback clear-cache();
    callback logout();
    callback check-update();
    callback install-update();
    callback cancel-update();

    VerticalLayout {
        padding: 18px;
        padding-left: 24px;
        padding-top: 14px;
        padding-right: 24px;

        Flickable {
            vertical-stretch: 1;
            content-height: 1140px;

            VerticalLayout {
                alignment: start;
                spacing: 14px;

                Text {
                    text: "Настройки";
                    font-size: 24px;
                    font-weight: 700;
                    color: Theme.text;
                }

                // ============ Внешний вид ============
                SettingsCard {
                    title: "Внешний вид";
                    Text {
                        text: "Тема применяется мгновенно и сохраняется между запусками";
                        font-size: 12.5px;
                        color: Theme.text-3;
                    }

                    Text {
                        text: "Темы";
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Theme.text-2;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ThemeCard {
                            title: "Fluent \u{00B7} Тёмная";
                            p-bg: #202020; p-side: #1C1C1C; p-card: #2A2A2A; p-accent: #4CC2FF;
                            active: root.preset == "fluent-dark";
                            clicked => { root.set-theme("fluent-dark"); }
                        }
                        ThemeCard {
                            title: "Fluent \u{00B7} Светлая";
                            p-bg: #F3F3F3; p-side: #EAEAEA; p-card: #FFFFFF; p-accent: #0067C0;
                            light: true;
                            active: root.preset == "fluent-light";
                            clicked => { root.set-theme("fluent-light"); }
                        }
                        ThemeCard {
                            title: "Тёплая пастель";
                            p-bg: #F6EDE3; p-side: #F1E4D6; p-card: #FDFAF5; p-accent: #C2725A;
                            light: true;
                            active: root.preset == "pastel-warm";
                            clicked => { root.set-theme("pastel-warm"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ThemeCard {
                            title: "Мятная пастель";
                            p-bg: #ECF3F0; p-side: #E4EEE9; p-card: #FAFEFC; p-accent: #4E8D77;
                            light: true;
                            active: root.preset == "pastel-mint";
                            clicked => { root.set-theme("pastel-mint"); }
                        }
                        ThemeCard {
                            title: "Монохром \u{00B7} Тёмная";
                            p-bg: #0D0D0D; p-side: #0A0A0A; p-card: #161616; p-accent: #E8E8E8;
                            active: root.preset == "mono-dark";
                            clicked => { root.set-theme("mono-dark"); }
                        }
                        ThemeCard {
                            title: "Монохром \u{00B7} Светлая";
                            p-bg: #FAFAFA; p-side: #F0F0F0; p-card: #FFFFFF; p-accent: #1A1A1A;
                            light: true;
                            active: root.preset == "mono-light";
                            clicked => { root.set-theme("mono-light"); }
                        }
                    }

                    Text {
                        text: "Акцентный цвет";
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Theme.text-2;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        AccentSwatch { swatch: #4CC2FF; active: root.accent-custom == "#4CC2FF"; clicked => { root.set-accent("#4CC2FF"); } }
                        AccentSwatch { swatch: #0067C0; active: root.accent-custom == "#0067C0"; clicked => { root.set-accent("#0067C0"); } }
                        AccentSwatch { swatch: #C2725A; active: root.accent-custom == "#C2725A"; clicked => { root.set-accent("#C2725A"); } }
                        AccentSwatch { swatch: #4E8D77; active: root.accent-custom == "#4E8D77"; clicked => { root.set-accent("#4E8D77"); } }
                        AccentSwatch { swatch: #9333EA; active: root.accent-custom == "#9333EA"; clicked => { root.set-accent("#9333EA"); } }
                        AccentSwatch { swatch: #E8E8E8; active: root.accent-custom == "#E8E8E8"; clicked => { root.set-accent("#E8E8E8"); } }
                        AccentSwatch { swatch: #FB7185; active: root.accent-custom == "#FB7185"; clicked => { root.set-accent("#FB7185"); } }
                        AccentSwatch { swatch: #F59E0B; active: root.accent-custom == "#F59E0B"; clicked => { root.set-accent("#F59E0B"); } }
                        Rectangle { width: 8px; }
                        ActionButton {
                            label: root.accent-custom != "" ? "Сбросить акцент" : "Акцент темы по умолчанию";
                            height: 30px;
                            clicked => { root.set-accent(""); }
                        }
                    }
                }

                // ============ Загрузки ============
                SettingsCard {
                    title: "Загрузки";
                    Text {
                        text: "Файлы сохраняются только для треков, доступных по вашей подписке";
                        font-size: 12.5px;
                        color: Theme.text-3;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Каталог загрузок";
                            font-size: 13px;
                            color: Theme.text-2;
                            vertical-alignment: center;
                            width: 130px;
                        }
                        Rectangle {
                            height: 36px;
                            horizontal-stretch: 1;
                            border-radius: Theme.r-ctl;
                            background: Theme.fill;
                            border-width: 1px;
                            border-color: Theme.stroke;
                            Text {
                                text: root.downloads-dir;
                                font-size: 12.5px;
                                color: Theme.text-2;
                                vertical-alignment: center;
                                x: 12px;
                                width: parent.width - 100px;
                                overflow: elide;
                            }
                            ActionButton {
                                label: "Выбрать";
                                height: 28px;
                                x: parent.width - self.width - 6px;
                                y: (parent.height - 28px) / 2;
                                clicked => { root.pick-downloads-dir(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Качество";
                            font-size: 13px;
                            color: Theme.text-2;
                            vertical-alignment: center;
                            width: 130px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                        }
                    }
                }

                // ============ Кеш ============
                SettingsCard {
                    title: "Кеш";
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Обложки и прослушанные треки: " + root.cache-size;
                            font-size: 12.5px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        ActionButton {
                            label: "Очистить";
                            height: 30px;
                            clicked => { root.clear-cache(); }
                        }
                    }
                }

                // ============ Аккаунт ============
                SettingsCard {
                    title: "Аккаунт";
                    Text {
                        text: root.user-name + (root.user-login != "" ? " \u{00B7} " + root.user-login : "");
                        font-size: 13px;
                        color: Theme.text-2;
                    }
                    Text {
                        text: root.user-plan + (root.storage-kind != "" ? " \u{00B7} токен: " + root.storage-kind : "");
                        font-size: 12.5px;
                        color: Theme.accent;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton {
                            label: "Выйти из аккаунта";
                            height: 32px;
                            clicked => { root.logout(); }
                        }
                    }
                }

                // ============ Обновление ============
                SettingsCard {
                    title: "Обновление";
                    Text {
                        text: "Проверка выполняется автоматически при запуске · канал: GitHub Releases";
                        font-size: 12.5px;
                        color: Theme.text-3;
                    }

                    // Статус по состоянию
                    if root.update-state == 1: Text {
                        text: "Проверяем обновления…";
                        font-size: 13px;
                        color: Theme.text-2;
                    }
                    if root.update-state == 2: Text {
                        text: "Установлена последняя версия (" + root.version + ")";
                        font-size: 13px;
                        color: Theme.text-2;
                    }
                    if root.update-state == 3: Text {
                        text: "Доступна новая версия: " + root.update-version;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                    if root.update-state == 4: Text {
                        text: "Скачивание обновления… " + Math.round(root.update-progress * 100) + "%";
                        font-size: 13px;
                        color: Theme.text-2;
                    }
                    if root.update-state == 5: Text {
                        text: root.update-error;
                        font-size: 12.5px;
                        color: #F0716E;
                        wrap: word-wrap;
                    }

                    // Примечания к версии
                    if root.update-state == 3 && root.update-notes != "": Text {
                        text: root.update-notes;
                        font-size: 12.5px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }

                    // Прогресс-бар скачивания
                    if root.update-state == 4: Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.fill;
                        Rectangle {
                            x: 0; y: 0;
                            height: 100%;
                            border-radius: 3px;
                            width: parent.width * Math.min(1.0, Math.max(0.0, root.update-progress));
                            background: Theme.accent;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        // Установить / открыть страницу релиза
                        if root.update-state == 3: ActionButton {
                            label: root.update-installer ? "Скачать и установить" : "Открыть страницу загрузки";
                            icon: root.update-installer ? Icons.download : Icons.external;
                            height: 32px;
                            clicked => { root.install-update(); }
                        }

                        // Отмена скачивания
                        if root.update-state == 4: ActionButton {
                            label: "Отменить";
                            height: 32px;
                            clicked => { root.cancel-update(); }
                        }

                        // Проверить / повторить
                        if root.update-state != 1 && root.update-state != 4: ActionButton {
                            label: "Проверить обновления";
                            height: 32px;
                            clicked => { root.check-update(); }
                        }
                    }
                }

                // ============ О приложении ============
                SettingsCard {
                    title: "О приложении";
                    Text {
                        text: "Auris " + root.version + " \u{2014} неофициальный клиент. Не аффилирован с Яндексом.";
                        font-size: 12.5px;
                        color: Theme.text-3;
                    }
                    Text {
                        text: "Лицензия GPLv3 \u{00B7} Исходники: github.com/VinylRUS/Auris";
                        font-size: 12.5px;
                        color: Theme.text-3;
                    }
                }

                Rectangle { height: 12px; }
            }
        }
    }
}
