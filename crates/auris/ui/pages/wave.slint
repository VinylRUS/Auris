// «Моя волна»: большой хиро, лайк/дизлайк, ближайшие треки.
import { Theme } from "../theme.slint";
import { Icons, Icon, EqBars } from "../icons.slint";
import { ActionButton, Cover, IconButton, PlayButton, TrackRow } from "../widgets.slint";
import { TrackItem } from "../structs.slint";

export component WavePage inherits Rectangle {
    in property <bool> active: false;
    in property <string> title: "Моя волна";
    in property <string> artists: "";
    in property <image> cover;
    in property <int> cover-variant: 1;
    in property <bool> playing: false;
    in property <float> position-sec: 0;
    in property <float> duration-sec: 1;
    in property <bool> liked: false;
    in property <[TrackItem]> upcoming;

    callback start-wave();
    callback toggle-play();
    callback next();
    callback like();
    callback dislike();
    callback seek(float);
    callback play-index(int);
    callback like-toggled(int);

    background: @linear-gradient(160deg, Theme.accent-fill, Theme.bg 60%);

    VerticalLayout {
        padding: 24px;
        padding-top: 18px;
        spacing: 6px;

        Rectangle {
            vertical-stretch: 1;

            Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;   // разрывает цикл min-width (дефолт смотрит на детей)
            content-height: 480px + 52px * root.upcoming.length;
            VerticalLayout {
                alignment: start;
                spacing: 0;

                // ---- Хиро ----
                Rectangle {
                    height: 220px;
                    border-radius: Theme.r-card;
                    background: @linear-gradient(115deg, Theme.accent-fill, transparent 70%);

                    Path {
                        property <length> dx: 0px;
                        init => { dx = 30px; }
                        x: parent.width - 350px + self.dx;
                        y: 20px;
                        width: 320px; height: 180px;
                        viewbox-width: 320; viewbox-height: 180;
                        stroke: Theme.accent;
                        stroke-width: 2px;
                        fill: transparent;
                        opacity: 0.45;
                        animate dx { duration: 6000ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
                        commands: "M 0 100 Q 40 20 80 100 T 160 100 T 240 100 T 320 100";
                    }
                    Path {
                        property <length> dx: 30px;
                        init => { dx = 0px; }
                        x: parent.width - 350px + self.dx;
                        y: 20px;
                        width: 320px; height: 180px;
                        viewbox-width: 320; viewbox-height: 180;
                        stroke: Theme.accent;
                        stroke-width: 1.6px;
                        fill: transparent;
                        opacity: 0.25;
                        animate dx { duration: 7300ms; iteration-count: -1; direction: alternate; easing: ease-in-out; }
                        commands: "M 0 130 Q 40 70 80 130 T 160 130 T 240 130 T 320 130";
                    }

                    HorizontalLayout {
                        padding: 26px;
                        spacing: 22px;

                        if root.active: Cover {
                            width: 168px; height: 168px;
                            cover-image: root.cover;
                            cover-variant: root.cover-variant;
                            radius: 10px;
                        }
                        if !root.active: Rectangle {
                            width: 168px; height: 168px;
                            border-radius: 10px;
                            background: Theme.fill;
                            border-width: 1px;
                            border-color: Theme.stroke;
                            Icon {
                                source: Icons.wave;
                                size: 64px;
                                tint: Theme.text-3;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                if root.active && root.playing: EqBars {
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: root.active ? "ИГРАЕТ СЕЙЧАС" : "ПЕРСОНАЛЬНЫЙ ПОТОК";
                                    font-size: 11.5px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.active ? root.title : "Моя волна";
                                font-size: 28px;
                                font-weight: 700;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: root.active ? root.artists : "Бесконечный микс из любимых треков и новых открытий";
                                font-size: 14px;
                                color: Theme.text-2;
                                overflow: elide;
                            }

                            Rectangle { height: 6px; }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                if root.active: IconButton {
                                    source: root.liked ? Icons.heart-filled : Icons.heart;
                                    on: root.liked;
                                    icon-size: 20px;
                                    size: 38px;
                                    clicked => { root.like(); }
                                }
                                if root.active: IconButton {
                                    source: Icons.error;
                                    icon-size: 18px;
                                    size: 38px;
                                    clicked => { root.dislike(); }
                                }
                                if !root.active: ActionButton {
                                    label: "Слушать волну";
                                    icon: Icons.play;
                                    accent: true;
                                    height: 38px;
                                    clicked => { root.start-wave(); }
                                }
                                if root.active: PlayButton {
                                    playing: root.playing;
                                    size: 44px;
                                    clicked => { root.toggle-play(); }
                                }
                                if root.active: IconButton {
                                    source: Icons.next;
                                    icon-size: 20px;
                                    size: 38px;
                                    y: 3px;
                                    clicked => { root.next(); }
                                }
                            }
                        }
                    }
                }

                // ---- Ближайшие треки ----
                if root.upcoming.length > 0: VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Дальше в волне";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    for item[i] in root.upcoming: TrackRow {
                        index: i + 1;
                        title: item.title;
                        artists: item.artists;
                        album: item.album;
                        duration-sec: item.duration-sec;
                        cover-image: item.cover;
                        cover-variant: item.cover-variant;
                        liked: item.liked;
                        is-current: item.is-current;
                        is-playing: item.is-playing;
                        clicked => { root.play-index(i); }
                        like-toggled => { root.like-toggled(i); }
                        download-clicked => { }
                    }
                }
                Rectangle { height: 12px; }
            }
                    }
        }
    }
}
