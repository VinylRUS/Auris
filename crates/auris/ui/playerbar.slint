// Плеер-бар (нижняя плавающая карточка по мокапу).
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { Cover, IconButton, PlayButton, SliderBar } from "widgets.slint";

export component PlayerBar inherits Rectangle {
    in property <string> title: "";
    in property <string> artists: "";
    in property <image> cover;
    in property <int> cover-variant: 1;
    in property <bool> playing: false;
    in property <bool> liked: false;
    in property <float> position-sec: 0;
    in property <float> duration-sec: 1;
    in-out property <float> volume: 0.7;
    in property <bool> shuffle: false;
    in property <int> repeat: 0;        // 0 выкл, 1 все, 2 один
    in property <bool> queue-open: false;
    in property <bool> lyrics-open: false;

    callback toggle-play();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-like();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-queue();
    callback toggle-lyrics();

    // состояние mute (чисто UI: громкость 0 ↔ сохранённое значение)
    property <float> pre-mute: 0.7;

    height: 92px;
    border-radius: 10px;
    // Фон — из темы (раньше хардкод rgba(30,30,30,0.94): в светлых
    // темах плеер был чёрным пятном).
    background: Theme.bg-deep.with-alpha(0.94);
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 7px;
    drop-shadow-color: #40000000;

    HorizontalLayout {
        padding-left: 18px; padding-right: 18px;
        spacing: 12px;

        // ---- Левая треть: трек ----
        // Вертикальные паддинги центрируют контент (максимум высоты —
        // обложка 48px): layout-ы топ-выравнивают фиксированных детей,
        // явные y-биндинги в layout — анти-паттерн (см. историю бага
        // с ползунком громкости).
        HorizontalLayout {
            horizontal-stretch: 10;
            spacing: 14px;
            padding-top: 22px;
            padding-bottom: 22px;
            Cover {
                width: 48px; height: 48px;
                cover-image: root.cover;
                cover-variant: root.cover-variant;
                radius: 6px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.artists;
                    font-size: 12px;
                    color: Theme.text-3;
                    overflow: elide;
                }
            }
            // Лайк (с «поп»-анимацией): контейнер во всю высоту строки
            // (48px) — кнопка 34px центрируется внутри как в обычном
            // позиционировании, а не топ-выравнивается layout-ом.
            Rectangle {
                width: 48px; height: 48px;
                transform-scale-x: root.liked ? 112% : 100%;
                transform-scale-y: root.liked ? 112% : 100%;
                animate transform-scale-x { duration: 170ms; easing: ease-out; }
                animate transform-scale-y { duration: 170ms; easing: ease-out; }
                IconButton {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 34px; height: 34px;
                    source: root.liked ? Icons.heart-filled : Icons.heart;
                    on: root.liked;
                    icon-size: 18px;
                    clicked => { root.toggle-like(); }
                }
            }
        }

        // ---- Центр: управление + прогресс ----
        VerticalLayout {
            horizontal-stretch: 12;
            alignment: center;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                // Боковые кнопки — 42px (высота play-кнопки): иначе
                // layout топ-выравнивает их и иконки сидят на 5px выше
                // центра play.
                IconButton {
                    source: Icons.shuffle; on: root.shuffle; icon-size: 18px;
                    size: 42px;
                    clicked => { root.toggle-shuffle(); }
                }
                IconButton { source: Icons.prev; icon-size: 19px; size: 42px; clicked => { root.prev(); } }
                PlayButton {
                    playing: root.playing;
                    size: 42px;
                    clicked => { root.toggle-play(); }
                }
                IconButton { source: Icons.next; icon-size: 19px; size: 42px; clicked => { root.next(); } }
                IconButton {
                    source: root.repeat == 2 ? Icons.repeat-one : Icons.repeat;
                    on: root.repeat > 0;
                    icon-size: 18px;
                    size: 42px;
                    clicked => { root.cycle-repeat(); }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                // Высоту строке задаёт SliderBar (32px), тексты
                // растягиваются на неё и центрируются по вертикали.
                Text {
                    text: Theme.fmt-time(root.position-sec);
                    font-size: 11.5px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                SliderBar {
                    horizontal-stretch: 1;
                    thumb-always: false;
                    value: root.duration-sec > 0 ? root.position-sec / root.duration-sec : 0;
                    changed(v) => { root.seek(v); }
                }
                Text {
                    text: Theme.fmt-time(root.duration-sec);
                    font-size: 11.5px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
            }
        }

        // ---- Правая треть: лирика + очередь + громкость ----
        // Паддинги центрируют строку иконок+слайдера (высота группы
        // 32px). Раньше явный y-биндинг + растянутая высота SliderBar-а
        // сдвигали ползунок громкости к нижнему краю панели, а после
        // удаления y layout топ-выравнивал группу.
        HorizontalLayout {
            horizontal-stretch: 10;
            alignment: end;
            spacing: 8px;
            padding-top: 30px;
            padding-bottom: 30px;
            IconButton {
                source: Icons.lyrics;
                on: root.lyrics-open;
                icon-size: 17px;
                clicked => { root.toggle-lyrics(); }
            }
            IconButton {
                source: Icons.queue;
                on: root.queue-open;
                icon-size: 17px;
                clicked => { root.toggle-queue(); }
            }
            // Громкость: клик по иконке = mute/unmute
            IconButton {
                source: root.volume <= 0.001 ? Icons.volume-0
                      : root.volume < 0.45 ? Icons.volume-1 : Icons.volume-2;
                icon-size: 17px;
                clicked => {
                    if (root.volume > 0.001) {
                        root.pre-mute = root.volume;
                        root.set-volume(0);
                        root.volume = 0;
                    } else {
                        root.volume = root.pre-mute > 0.001 ? root.pre-mute : 0.7;
                        root.set-volume(root.volume);
                    }
                }
            }
            SliderBar {
                width: 88px;
                value: root.volume;
                changed(v) => { root.set-volume(v); }
            }
        }
    }
}
