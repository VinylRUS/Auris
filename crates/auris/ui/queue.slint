// Правая панель очереди (по мокапу).
import { Theme } from "theme.slint";
import { Cover, IconButton, Icon } from "widgets.slint";
import { TrackItem } from "structs.slint";

export component QueuePanel inherits Rectangle {
    in property <[TrackItem]> items;
    in property <string> source-label: "";
    callback play-index(int);
    callback remove-index(int);

    width: 300px;
    background: rgba(255, 255, 255, 0.02);
    Rectangle {
        x: 0;
        width: 1px;
        y: 0;
        height: 100%;
        background: Theme.stroke;
    }

    VerticalLayout {
        padding: 18px;
        padding-top: 14px;
        padding-right: 16px;
        spacing: 4px;

        Text {
            text: "Очередь";
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: root.source-label;
            font-size: 12px;
            color: Theme.text-3;
            overflow: elide;
        }

        // Список с прокруткой
        Flickable {
            vertical-stretch: 1;
            content-height: 64px + 44px * root.items.length + 16px;
            VerticalLayout {
                padding: 0;
                spacing: 2px;

                // «Играет сейчас»
                for item[i] in root.items: Rectangle {
                    visible: item.is-current;
                    height: 64px;
                    border-radius: Theme.r-card;
                    background: Theme.fill;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Cover {
                            width: 44px; height: 44px;
                            cover-image: item.cover;
                            cover-variant: item.cover-variant;
                            radius: 6px;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: item.title;
                                font-size: 13.5px;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: "Играет сейчас";
                                font-size: 12px;
                                color: Theme.accent;
                            }
                        }
                        Icon {
                            text: "\u{266B}";
                            color: Theme.accent;
                            font-size: 15px;
                        }
                    }
                }

                for item[i] in root.items: Rectangle {
                    visible: !item.is-current;
                    height: 44px;
                    border-radius: Theme.r-ctl;
                    background: ta.has-hover ? Theme.fill : transparent;
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.play-index(i); }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        spacing: 12px;
                        Cover {
                            width: 34px; height: 34px;
                            y: (parent.height - 34px) / 2;
                            cover-image: item.cover;
                            cover-variant: item.cover-variant;
                            radius: 4px;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: item.title;
                                font-size: 13px;
                                color: item.is-current ? Theme.accent : Theme.text-2;
                                overflow: elide;
                            }
                            Text {
                                text: item.artists;
                                font-size: 11.5px;
                                color: Theme.text-3;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: Theme.fmt-time(item.duration-sec);
                            font-size: 12px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                        IconButton {
                            glyph: "\u{2715}";
                            size: 24px;
                            glyph-size: 10px;
                            y: (parent.height - 24px) / 2;
                            clicked => { root.remove-index(i); }
                        }
                    }
                }
            }
        }
    }
}
