// Правая панель очереди (по мокапу).
import { Theme } from "theme.slint";
import { Icons, Icon, EqBars } from "icons.slint";
import { Cover, IconButton } from "widgets.slint";
import { TrackItem } from "structs.slint";

export component QueuePanel inherits Rectangle {
    in property <[TrackItem]> items;
    in property <string> source-label: "";
    // Ширина управляется извне (main.slint делает её адаптивной);
    // дефолт сохранён для автономного использования.
    in property <length> panel-width: 300px;
    callback play-index(int);
    callback remove-index(int);
    callback close();

    width: panel-width;
    // Подложка из темы (раньше хардкод rgba(255,255,255,0.02)).
    background: Theme.fill.with-alpha(0.02);
    Rectangle {
        x: 0;
        width: 1px;
        y: 0;
        height: 100%;
        background: Theme.stroke;
    }

    VerticalLayout {
        padding: 18px;
        padding-top: 14px;
        padding-right: 16px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Очередь";
                font-size: 15px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                source: Icons.close;
                size: 26px;
                icon-size: 13px;
                clicked => { root.close(); }
            }
        }
        Text {
            text: root.source-label;
            font-size: 12px;
            color: Theme.text-3;
            overflow: elide;
        }

        // Список с прокруткой
        Rectangle {
            vertical-stretch: 1;

            Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;   // разрывает цикл min-width (дефолт смотрит на детей)
            content-height: 64px + 44px * root.items.length + 16px;
            VerticalLayout {
                alignment: start;
                padding: 0;
                spacing: 2px;

                // «Играет сейчас»
                for item[i] in root.items: Rectangle {
                    visible: item.is-current;
                    height: 64px;
                    border-radius: Theme.r-card;
                    background: Theme.accent.with-alpha(0.07);
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.25);
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Cover {
                            width: 44px; height: 44px;
                            cover-image: item.cover;
                            cover-variant: item.cover-variant;
                            radius: 6px;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: item.title;
                                font-size: 13.5px;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: "Играет сейчас";
                                font-size: 12px;
                                color: Theme.accent;
                            }
                        }
                        Rectangle {
                            width: 16px;
                            if item.is-playing: EqBars {
                                x: 0;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                for item[i] in root.items: Rectangle {
                    visible: !item.is-current;
                    height: 44px;
                    border-radius: Theme.r-ctl;
                    background: ta.has-hover ? Theme.fill : transparent;
                    animate background { duration: 90ms; }
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.play-index(i); }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        spacing: 12px;
                        Cover {
                            width: 34px; height: 34px;
                            y: (parent.height - 34px) / 2;
                            cover-image: item.cover;
                            cover-variant: item.cover-variant;
                            radius: 4px;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: item.title;
                                font-size: 13px;
                                color: item.is-current ? Theme.accent : Theme.text-2;
                                overflow: elide;
                            }
                            Text {
                                text: item.artists;
                                font-size: 11.5px;
                                color: Theme.text-3;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: Theme.fmt-time(item.duration-sec);
                            font-size: 12px;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                    }
                    // Удаление из очереди — поверх длительности (без сдвига вёрстки)
                    Rectangle {
                        width: 34px;
                        x: parent.width - self.width - 4px;
                        height: 100%;
                        clip: false;
                        IconButton {
                            source: Icons.close;
                            size: 24px;
                            icon-size: 11px;
                            opacity: ta.has-hover ? 1 : 0;
                            animate opacity { duration: 100ms; }
                            x: (parent.width - 24px) / 2;
                            y: (parent.height - 24px) / 2;
                            clicked => { root.remove-index(i); }
                        }
                    }
                }
            }
                    }
        }
    }
}
