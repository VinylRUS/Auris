// Сайдбар (NavigationView по мокапу).
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";

export component NavItem inherits Rectangle {
    in property <image> source;
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 40px;
    border-radius: Theme.r-ctl;
    background: ta.pressed ? Theme.fill-hover
              : active ? Theme.accent-fill
              : ta.has-hover ? Theme.fill : transparent;
    animate background { duration: 100ms; }

    // Индикатор слева
    Rectangle {
        x: -2px;
        width: 3px;
        y: 11px; height: parent.height - 22px;
        border-radius: 2px;
        background: Theme.accent;
        visible: root.active;
    }

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 14px;
        Icon {
            source: root.source;
            size: 18px;
            tint: root.active ? Theme.accent : Theme.text-3;
            animate tint { duration: 100ms; }
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.text-on-accent-fill : Theme.text-2;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SideBar inherits Rectangle {
    in property <int> page: 0;
    in property <string> user-name: "";
    in property <string> user-plan: "";
    in property <string> user-initial: "";
    callback navigate(int);

    width: 264px;
    background: rgba(255, 255, 255, 0.015);
    // правая граница (Slint не умеет бордеры по сторонам)
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        y: 0;
        height: 100%;
        background: Theme.stroke;
    }

    VerticalLayout {
        padding: 4px;
        padding-right: 10px;
        padding-left: 10px;
        padding-bottom: 10px;
        spacing: 2px;

        // Поиск (кнопка-переход на страницу поиска)
        Rectangle {
            height: 36px;
            border-radius: Theme.r-ctl;
            background: sta.has-hover ? Theme.fill-hover : Theme.fill;
            border-width: 1px;
            border-color: Theme.stroke;
            animate background { duration: 100ms; }

            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                spacing: 10px;
                Icon {
                    source: Icons.search;
                    size: 15px;
                    tint: Theme.text-3;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "Поиск";
                    font-size: 13.5px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(1); }
            }
        }

        NavItem { source: Icons.home;     label: "Главная";    active: page == 0; clicked => { root.navigate(0); } }
        NavItem { source: Icons.wave;     label: "Моя волна";  active: page == 4; clicked => { root.navigate(4); } }
        NavItem { source: Icons.radio;    label: "Радио";      active: page == 6; clicked => { root.navigate(6); } }

        Text {
            text: "КОЛЛЕКЦИЯ";
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-3;
            letter-spacing: 0.8px;
        }

        NavItem { source: Icons.library;  label: "Библиотека"; active: page == 2; clicked => { root.navigate(2); } }
        NavItem { source: Icons.download; label: "Скачанное";  active: page == 3; clicked => { root.navigate(3); } }

        Rectangle { vertical-stretch: 1; }

        NavItem { source: Icons.settings; label: "Настройки";  active: page == 5; clicked => { root.navigate(5); } }

        // Пользователь (кликабельная карточка → настройки)
        Rectangle {
            height: 46px;
            border-radius: Theme.r-ctl;
            background: uta.has-hover ? Theme.fill : transparent;
            animate background { duration: 100ms; }
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                spacing: 12px;
                // Аватар: круг с первой буквой
                Rectangle {
                    width: 30px; height: 30px;
                    y: (parent.height - 30px) / 2;
                    border-radius: 15px;
                    background: @linear-gradient(135deg, #F472B6, #FB7185);
                    Text {
                        text: root.user-initial != "" ? root.user-initial : "?";
                        font-size: 12.5px;
                        font-weight: 700;
                        color: #FFFFFF;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.user-name;
                        font-size: 13.5px;
                        color: Theme.text-2;
                        overflow: elide;
                    }
                    Text {
                        text: root.user-plan;
                        font-size: 11.5px;
                        color: Theme.accent;
                        overflow: elide;
                    }
                }
                Icon {
                    source: Icons.chevron-right;
                    size: 13px;
                    tint: Theme.text-3;
                    opacity: uta.has-hover ? 1 : 0;
                    animate opacity { duration: 100ms; }
                    y: (parent.height - self.height) / 2;
                }
            }
            uta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(5); }
            }
        }
    }
}
