// Титлбар окна (без нативных декораций, Win11-стиль).
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";

// Кнопка заголовка окна (46×40, как в Win11)
component CaptionButton inherits Rectangle {
    callback clicked;
    in property <image> source;
    in property <color> hover-bg: #0DFFFFFF;
    in property <color> press-bg: #14FFFFFF;
    in property <bool> white-on-hover: false;   // для красного креста

    width: 46px;
    height: 40px;
    background: ta.pressed ? press-bg : ta.has-hover ? hover-bg : transparent;
    animate background { duration: 70ms; }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.source;
        size: 10px;
        tint: root.white-on-hover && ta.has-hover ? #FFFFFF : Theme.text-2;
    }
}

export component TitleBar inherits Rectangle {
    in property <string> app-name: "Auris";
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    in property <bool> maximized: false;

    height: 40px;
    background: transparent;

    WindowMoveArea {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 0px;
            spacing: 10px;

            // Логотип: скруглённый квадрат с эквалайзером
            Rectangle {
                width: 22px; height: 22px;
                y: (parent.height - 22px) / 2;
                border-radius: 6px;
                background: @linear-gradient(135deg, Theme.accent-deep, Theme.accent);
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: Icons.eq;
                    size: 13px;
                    tint: Theme.text-on-accent;
                }
            }
            Text {
                text: root.app-name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-2;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Кнопки окна (как в Win11: 46px, крест с красным наведением)
    HorizontalLayout {
        x: parent.width - 138px;
        width: 138px;
        height: parent.height;

        CaptionButton {
            source: Icons.win-minimize;
            clicked => { root.window-minimize(); }
        }
        CaptionButton {
            source: root.maximized ? Icons.win-restore : Icons.win-maximize;
            clicked => { root.window-maximize(); }
        }
        CaptionButton {
            source: Icons.win-close;
            hover-bg: #C42B1C;
            press-bg: #B12619;
            white-on-hover: true;
            clicked => { root.window-close(); }
        }
    }
}
