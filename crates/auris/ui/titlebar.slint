// Титлбар окна (без нативных декораций, как на мокапах).
import { Theme } from "theme.slint";
import { Icon } from "widgets.slint";

export component TitleBar inherits Rectangle {
    in property <string> app-name: "Auris";
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    in property <bool> maximized: false;

    height: 40px;
    background: transparent;

    WindowMoveArea {
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 0px;
            spacing: 10px;

            // Логотип: скруглённый квадрат с нотой
            Rectangle {
                width: 22px; height: 22px;
                y: (parent.height - 22px) / 2;
                border-radius: 6px;
                background: @linear-gradient(135deg, Theme.accent-deep, Theme.accent);
                Icon {
                    text: "\u{266A}";
                    font-size: 12px;
                    color: Theme.text-on-accent;
                }
            }
            Text {
                text: root.app-name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-2;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Кнопки окна (46px, как в Win11)
    HorizontalLayout {
        x: parent.width - 138px;
        width: 138px;
        height: parent.height;

        Rectangle {
            TouchArea {
                clicked => { root.window-minimize(); }
                mouse-cursor: pointer;
            }
            Icon {
                text: "\u{2014}";
                font-size: 10px;
                color: Theme.text-2;
                width: 100%; height: 100%;
            }
        }
        Rectangle {
            TouchArea {
                clicked => { root.window-maximize(); }
                mouse-cursor: pointer;
            }
            Icon {
                text: "\u{25A1}";
                font-size: 10.5px;
                color: Theme.text-2;
                width: 100%; height: 100%;
            }
        }
        Rectangle {
            background: ta.has-hover ? #C42B1C : transparent;
            ta := TouchArea {
                clicked => { root.window-close(); }
                mouse-cursor: pointer;
            }
            Icon {
                text: "\u{2715}";
                font-size: 10px;
                color: ta.has-hover ? #FFFFFF : Theme.text-2;
                width: 100%; height: 100%;
            }
        }
    }
}
