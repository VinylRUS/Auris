// Базовые виджеты Auris (Fluent-стиль по мокапам).
import { Theme } from "theme.slint";

// ---------- Градиентная заглушка обложки ----------
export component GradientCover inherits Rectangle {
    in property <int> variant: 1;
    clip: true;
    if variant == 1: Rectangle { background: @linear-gradient(135deg, #4F46E5, #9333EA); }
    if variant == 2: Rectangle { background: @linear-gradient(135deg, #0891B2, #4F46E5); }
    if variant == 3: Rectangle { background: @linear-gradient(135deg, #DB2777, #F43F5E); }
    if variant == 4: Rectangle { background: @linear-gradient(135deg, #059669, #0891B2); }
    if variant == 5: Rectangle { background: @linear-gradient(135deg, #D97706, #DC2626); }
    if variant == 6: Rectangle { background: @linear-gradient(135deg, #1F2937, #4B5563); }
    if variant == 7: Rectangle { background: @linear-gradient(135deg, #7C3AED, #BE185D); }
    if variant == 8: Rectangle { background: @linear-gradient(135deg, #0EA5E9, #2563EB); }
    if variant == 9: Rectangle { background: @linear-gradient(135deg, #4D7C0F, #0F766E); }
    if variant == 10: Rectangle { background: @linear-gradient(135deg, #334155, #0F172A); }

    // нота-заглушка
    Rectangle {
        width: 38%; height: 38%;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: rgba(255, 255, 255, 0.28);
    }
}

// ---------- Обложка (картинка или градиент) ----------
export component Cover inherits Rectangle {
    in property <image> cover-image;
    in property <int> cover-variant: 1;
    in property <length> radius: 8px;
    clip: true;
    border-radius: radius;

    if cover-image.width > 0: Image {
        source: cover-image;
        width: 100%; height: 100%;
        image-fit: cover;
    }
    if cover-image.width == 0: GradientCover { variant: cover-variant; }
}

// ---------- Иконка (векторный глиф из текста) ----------
// Slint не тянет иконочные шрифты: используем простые unicode-глифы,
// которые есть в системных шрифтах всех платформ.
export component Icon inherits Text {
    font-size: 15px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// ---------- Иконка-лупа (рисуем фигурами: глифа в шрифтах нет) ----------
export component MagnifierIcon inherits Rectangle {
    in property <length> size: 15px;
    in property <color> stroke-color: Theme.text-3;
    width: size; height: size;
    Rectangle {
        width: root.size * 0.62; height: root.size * 0.62;
        border-radius: self.width / 2;
        border-width: 1.6px;
        border-color: root.stroke-color;
    }
    Rectangle {
        width: 1.8px; height: root.size * 0.38;
        x: root.size * 0.72;
        y: root.size * 0.66;
        transform-rotation: 45deg;
        background: root.stroke-color;
    }
}

// ---------- Кнопка-иконка ----------
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> on: false;          // акцентное состояние
    in property <length> size: 32px;
    in property <length> glyph-size: 15px;
    callback clicked;

    width: size; height: size;
    border-radius: Theme.r-ctl;
    background: ta.has-hover ? Theme.fill-hover : transparent;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Icon {
        text: root.glyph;
        font-size: root.glyph-size;
        color: root.on ? Theme.accent
              : ta.has-hover ? Theme.text : Theme.text-3;
    }
}

// ---------- Круглая play-кнопка ----------
export component PlayButton inherits Rectangle {
    in property <bool> playing: false;
    in property <length> size: 40px;
    callback clicked;

    width: size; height: size;
    border-radius: size / 2;
    background: Theme.accent-deep;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Icon {
        text: root.playing ? "\u{2016}" : "\u{25B6}";   // ‖ / ▶
        font-size: root.size * 0.4;
        color: Theme.text-on-accent;
    }
}

// ---------- Кнопка ----------
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    in property <bool> primary-glyph: true;
    callback clicked;

    height: 34px;
    border-radius: Theme.r-ctl;
    background: accent ? Theme.accent-deep : (ta.has-hover ? Theme.fill-hover : Theme.fill);
    border-width: accent ? 0px : 1px;
    border-color: Theme.stroke-strong;

    HorizontalLayout {
        padding-left: 16px; padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if primary-glyph: Icon {
            text: "\u{25B6}";
            font-size: 11px;
            color: accent ? Theme.text-on-accent : Theme.text-2;
        }
        Text {
            text: label;
            font-size: 13.5px;
            vertical-alignment: center;
            color: accent ? Theme.text-on-accent : Theme.text;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------- Чип-фильтр ----------
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 30px;
    border-radius: self.height / 2;
    background: active ? Theme.accent-fill : (ta.has-hover ? Theme.fill-hover : Theme.fill);
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.stroke;

    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        Text {
            text: label;
            font-size: 13px;
            vertical-alignment: center;
            color: active ? Theme.text-on-accent-fill : Theme.text-2;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------- Слайдер (прогресс/громкость) ----------
export component SliderBar inherits Rectangle {
    in-out property <float> value: 0;      // 0..1
    in property <bool> thick-thumb: true;  // Fluent-точка
    callback changed(float);

    width: 18px;                          // зона захвата
    border-radius: self.height / 2;

    // дорожка
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.stroke-strong;

        Rectangle {
            width: parent.width * clamp(root.value, 0, 1);
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    // бегунок
    Rectangle {
        x: parent.width * clamp(root.value, 0, 1) - self.width / 2;
        y: (parent.height - (root.thick-thumb ? 12px : 8px)) / 2;
        width: root.thick-thumb ? 12px : 8px;
        height: root.thick-thumb ? 12px : 8px;
        border-radius: self.width / 2;
        background: Theme.accent;
        border-width: root.thick-thumb ? 3px : 0px;
        border-color: Theme.bg-deep;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed {
                root.value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.value);
            }
        }
        pointer-event => {
            if self.pressed {
                root.value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.value);
            }
        }
    }
}

// ---------- Заголовок секции ----------
export component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> link-text: "";
    callback link-clicked;

    spacing: 12px;
    alignment: start;
    Text {
        text: title;
        font-size: 16px;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    if link-text != "": TouchArea {
        clicked => { root.link-clicked(); }
        mouse-cursor: pointer;
        height: 22px;
        Text {
            text: link-text;
            font-size: 12.5px;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }
}

// ---------- Карточка-плитка (обложка + подписи) ----------
export component TileCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> cover-image;
    in property <int> cover-variant: 1;
    in property <length> tile-size: 148px;
    callback clicked;

    width: tile-size;
    height: tile-size + 42px;

    VerticalLayout {
        spacing: 0;
        Cover {
            cover-image: root.cover-image;
            cover-variant: root.cover-variant;
            width: root.tile-size;
            height: root.tile-size;
            radius: 8px;
        }
        Text {
            text: root.title;
            font-size: 13.5px;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
            height: 22px;
        }
        Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.text-3;
            overflow: elide;
            vertical-alignment: top;
            height: 18px;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------- Строка трека ----------
export component TrackRow inherits Rectangle {
    in property <int> index;
    in property <string> title;
    in property <string> artists;
    in property <string> album;
    in property <int> duration-sec;
    in property <image> cover-image;
    in property <int> cover-variant: 1;
    in property <bool> liked;
    in property <bool> is-current;
    in property <bool> is-playing;
    in property <int> dl-state;        // 0 нет, 1 очередь, 2 готово, 3 ошибка
    callback clicked;
    callback like-toggled;
    callback download-clicked;

    height: 52px;
    border-radius: Theme.r-ctl;
    background: ta.has-hover ? Theme.fill : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 14px;

        // Индекс / эквалайзер
        Rectangle {
            width: 26px;
            Text {
                text: root.is-current ? (root.is-playing ? "\u{266B}" : "\u{25B6}") : root.index;
                font-size: 13px;
                color: root.is-current ? Theme.accent : Theme.text-3;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 100%;
            }
        }

        Cover {
            width: 40px; height: 40px;
            y: (parent.height - 40px) / 2;
            cover-image: root.cover-image;
            cover-variant: root.cover-variant;
            radius: 4px;
        }

        // Название + исполнитель
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 10;
            Text {
                text: root.title;
                font-size: 13.5px;
                color: root.is-current ? Theme.accent : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.artists;
                font-size: 12px;
                color: Theme.text-3;
                overflow: elide;
            }
        }

        // Альбом
        Text {
            text: root.album;
            font-size: 13px;
            color: Theme.text-3;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 8;
        }

        // Длительность
        Text {
            text: Theme.fmt-time(root.duration-sec);
            font-size: 13px;
            color: Theme.text-3;
            vertical-alignment: center;
            width: 46px;
            horizontal-alignment: right;
        }

        // Действия: лайк + скачать
        Rectangle {
            width: 76px;
            HorizontalLayout {
                alignment: end;
                spacing: 2px;
                IconButton {
                    glyph: root.liked ? "\u{2665}" : "\u{2661}";
                    on: root.liked;
                    size: 28px;
                    glyph-size: 14px;
                    clicked => { root.like-toggled(); }
                }
                IconButton {
                    glyph: root.dl-state == 2 ? "\u{2713}" : root.dl-state == 3 ? "\u{2715}" : "\u{21D3}";
                    on: root.dl-state == 2;
                    size: 28px;
                    glyph-size: 13px;
                    clicked => { root.download-clicked(); }
                }
            }
        }
    }
}

// ---------- Переключатель Win11 ----------
export component Toggle inherits Rectangle {
    in property <bool> checked: false;
    callback toggled;

    width: 40px; height: 20px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent-deep : Theme.fill;
    border-width: checked ? 0px : 1px;
    border-color: Theme.stroke-strong;

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        width: 12px; height: 12px;
        border-radius: 6px;
        background: root.checked ? Theme.text-on-accent : Theme.text-2;
        animate x { duration: 120ms; easing: ease-out; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// ---------- Поле поиска ----------
export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Поиск";
    callback accepted(string);

    height: 36px;
    border-radius: Theme.r-ctl;
    background: Theme.fill;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.stroke;

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 10px;
        MagnifierIcon {
            size: 15px;
            stroke-color: Theme.text-3;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            if root.text == "": Text {
                text: root.placeholder;
                font-size: 13.5px;
                color: Theme.text-3;
                vertical-alignment: center;
            }
            input := TextInput {
                font-size: 13.5px;
                color: Theme.text;
                vertical-alignment: center;
                accepted => { root.accepted(root.text); }
            }
        }
        if root.text != "": IconButton {
            glyph: "\u{2715}";
            size: 24px;
            glyph-size: 11px;
            clicked => { root.text = ""; }
        }
    }
}
