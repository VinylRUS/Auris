// Базовые виджеты Auris (Fluent-стиль по мокапам).
// Все иконки — векторные SVG (icons.slint), тонируются colorize.
import { Theme } from "theme.slint";
import { Icons, Icon, EqBars } from "icons.slint";
import { TileItem } from "structs.slint";

// ---------- Градиентная заглушка обложки ----------
export component GradientCover inherits Rectangle {
    in property <int> variant: 1;
    clip: true;
    if variant == 1: Rectangle { background: @linear-gradient(135deg, #4F46E5, #9333EA); }
    if variant == 2: Rectangle { background: @linear-gradient(135deg, #0891B2, #4F46E5); }
    if variant == 3: Rectangle { background: @linear-gradient(135deg, #DB2777, #F43F5E); }
    if variant == 4: Rectangle { background: @linear-gradient(135deg, #059669, #0891B2); }
    if variant == 5: Rectangle { background: @linear-gradient(135deg, #D97706, #DC2626); }
    if variant == 6: Rectangle { background: @linear-gradient(135deg, #1F2937, #4B5563); }
    if variant == 7: Rectangle { background: @linear-gradient(135deg, #7C3AED, #BE185D); }
    if variant == 8: Rectangle { background: @linear-gradient(135deg, #0EA5E9, #2563EB); }
    if variant == 9: Rectangle { background: @linear-gradient(135deg, #4D7C0F, #0F766E); }
    if variant == 10: Rectangle { background: @linear-gradient(135deg, #334155, #0F172A); }

    // нота-заглушка
    Icon {
        source: Icons.note;
        size: min(parent.width, parent.height) * 0.4;
        tint: rgba(255, 255, 255, 0.35);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ---------- Обложка (картинка или градиент) ----------
export component Cover inherits Rectangle {
    in property <image> cover-image;
    in property <int> cover-variant: 1;
    in property <length> radius: 8px;
    clip: true;
    border-radius: radius;

    if cover-image.width > 0: Image {
        source: cover-image;
        width: 100%; height: 100%;
        image-fit: cover;
    }
    if cover-image.width == 0: GradientCover { variant: cover-variant; }
}

// ---------- Кнопка-иконка ----------
export component IconButton inherits Rectangle {
    in property <image> source;             // иконка (Icons.*)
    in property <bool> on: false;           // акцентное состояние
    in property <length> size: 32px;        // размер кнопки
    in property <length> icon-size: 16px;   // размер иконки
    in property <bool> interactive: true;   // false — декоративная (не кликается)
    callback clicked;

    width: size; height: size;
    border-radius: Theme.r-ctl;
    background: ta.pressed ? Theme.fill-hover
              : ta.has-hover ? Theme.fill : transparent;
    animate background { duration: 90ms; }

    ta := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.source;
        size: root.icon-size;
        tint: root.on ? Theme.accent
              : ta.has-hover ? Theme.text : Theme.text-3;
        animate tint { duration: 100ms; }
    }
}

// ---------- Круглая play-кнопка ----------
export component PlayButton inherits Rectangle {
    in property <bool> playing: false;
    in property <length> size: 40px;
    callback clicked;

    width: size; height: size;
    border-radius: size / 2;
    background: ta.has-hover ? Theme.accent : Theme.accent-deep;
    animate background { duration: 130ms; }

    transform-scale-x: ta.pressed ? 94% : ta.has-hover ? 106% : 100%;
    transform-scale-y: ta.pressed ? 94% : ta.has-hover ? 106% : 100%;
    animate transform-scale-x { duration: 110ms; easing: ease-out; }
    animate transform-scale-y { duration: 110ms; easing: ease-out; }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Icon {
        x: (parent.width - self.width) / 2 + (root.playing ? 0px : 1px);
        y: (parent.height - self.height) / 2;
        source: root.playing ? Icons.pause : Icons.play;
        size: root.size * 0.42;
        tint: Theme.text-on-accent;
    }
}

// ---------- Кнопка с текстом (и опциональной иконкой) ----------
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    in property <image> icon;               // опционально: Icons.play и т.п.
    callback clicked;

    height: 34px;
    border-radius: Theme.r-ctl;
    background: accent
        ? (ta.pressed ? Theme.accent-deep : ta.has-hover ? Theme.accent : Theme.accent-deep)
        : (ta.pressed ? Theme.fill-hover : ta.has-hover ? Theme.fill-hover : Theme.fill);
    border-width: accent ? 0px : 1px;
    border-color: Theme.stroke-strong;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 16px; padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0: Icon {
            source: root.icon;
            size: 14px;
            tint: accent ? Theme.text-on-accent : Theme.text-2;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: label;
            font-size: 13.5px;
            font-weight: accent ? 600 : 400;
            vertical-alignment: center;
            color: accent ? Theme.text-on-accent : Theme.text;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------- Чип-фильтр ----------
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 30px;
    border-radius: self.height / 2;
    background: active ? Theme.accent-fill : (ta.has-hover ? Theme.fill-hover : Theme.fill);
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.stroke;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        Text {
            text: label;
            font-size: 13px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
            color: active ? Theme.text-on-accent-fill : Theme.text-2;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ---------- Слайдер (прогресс/громкость, Fluent) ----------
export component SliderBar inherits Rectangle {
    in-out property <float> value: 0;         // 0..1
    in property <bool> thumb-always: true;    // точка видна всегда (громкость)
    callback changed(float);

    width: 18px;                              // зона захвата
    property <bool> hot: ta.has-hover || ta.pressed;

    // дорожка (утолщается при наведении)
    Rectangle {
        y: (parent.height - (root.hot ? 6px : 4px)) / 2;
        height: root.hot ? 6px : 4px;
        border-radius: self.height / 2;
        background: Theme.stroke-strong;
        animate height { duration: 90ms; }
        animate y { duration: 90ms; }

        Rectangle {
            width: parent.width * clamp(root.value, 0, 1);
            border-radius: parent.height / 2;
            background: Theme.accent;
        }
    }

    // бегунок
    Rectangle {
        x: parent.width * clamp(root.value, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: root.hot ? 13px : 11px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent;
        border-width: 3px;
        border-color: Theme.bg-deep;
        opacity: root.thumb-always || root.hot ? 1 : 0;
        animate opacity { duration: 120ms; }
        animate width { duration: 90ms; }
        animate height { duration: 90ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed {
                root.value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.value);
            }
        }
        pointer-event => {
            if self.pressed {
                root.value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.value);
            }
        }
    }
}

// ---------- Заголовок секции ----------
export component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> link-text: "";
    callback link-clicked;

    spacing: 12px;
    alignment: start;
    Text {
        text: title;
        font-size: 16px;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    if link-text != "": TouchArea {
        clicked => { root.link-clicked(); }
        mouse-cursor: pointer;
        height: 22px;
        Text {
            text: link-text;
            font-size: 12.5px;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }
}

// ---------- Карточка-плитка (обложка + подписи + play при наведении) ----------
export component TileCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> cover-image;
    in property <int> cover-variant: 1;
    in property <length> tile-size: 148px;
    callback clicked;

    width: tile-size;
    height: tile-size + 44px;

    VerticalLayout {
        spacing: 0;
        Cover {
            cover-image: root.cover-image;
            cover-variant: root.cover-variant;
            width: root.tile-size;
            height: root.tile-size;
            radius: 8px;
        }
        Text {
            text: root.title;
            font-size: 13.5px;
            font-weight: 500;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
            height: 24px;
        }
        Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.text-3;
            overflow: elide;
            vertical-alignment: top;
            height: 18px;
        }
    }

    // Затемнение + круглая play-кнопка при наведении
    Rectangle {
        y: 0;
        width: root.tile-size;
        height: root.tile-size;
        border-radius: 8px;
        background: Theme.fill-hover;
        opacity: ta.has-hover ? 1 : 0;
        animate opacity { duration: 150ms; }

        Rectangle {
            width: 46px; height: 46px;
            border-radius: 23px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.accent-deep;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #4D000000;
            Icon {
                x: (parent.width - self.width) / 2 + 1px;
                y: (parent.height - self.height) / 2;
                source: Icons.play;
                size: 18px;
                tint: Theme.text-on-accent;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------- Строка трека ----------
export component TrackRow inherits Rectangle {
    in property <int> index;
    in property <string> title;
    in property <string> artists;
    in property <string> album;
    in property <int> duration-sec;
    in property <image> cover-image;
    in property <int> cover-variant: 1;
    in property <bool> liked;
    in property <bool> is-current;
    in property <bool> is-playing;
    in property <int> dl-state;        // 0 нет, 1 очередь, 2 готово, 3 ошибка
    callback clicked;
    callback like-toggled;
    callback download-clicked;

    height: 52px;
    border-radius: Theme.r-ctl;

    // подсветка текущего трека
    Rectangle {
        border-radius: Theme.r-ctl;
        background: Theme.accent;
        opacity: root.is-current ? 0.06 : 0;
        animate opacity { duration: 150ms; }
    }
    background: ta.has-hover ? Theme.fill : transparent;
    animate background { duration: 90ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 14px;

        // Индекс / эквалайзер
        Rectangle {
            width: 26px;
            if root.is-current && root.is-playing: EqBars {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.is-current && !root.is-playing: Icon {
                source: Icons.play;
                size: 14px;
                tint: Theme.accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if !root.is-current: Text {
                text: root.index;
                font-size: 13px;
                color: Theme.text-3;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 100%;
            }
        }

        Cover {
            width: 40px; height: 40px;
            y: (parent.height - 40px) / 2;
            cover-image: root.cover-image;
            cover-variant: root.cover-variant;
            radius: 4px;
        }

        // Название + исполнитель
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: root.is-current ? 600 : 400;
                color: root.is-current ? Theme.accent : Theme.text;
                overflow: elide;
            }
            Text {
                text: root.artists;
                font-size: 12px;
                color: Theme.text-3;
                overflow: elide;
            }
        }

        // Альбом (фиксированная доля ширины строки — как в Spotify)
        Text {
            text: root.album;
            font-size: 13px;
            color: Theme.text-3;
            overflow: elide;
            vertical-alignment: center;
            width: parent.width * 0.22;
        }

        // Длительность
        Text {
            text: Theme.fmt-time(root.duration-sec);
            font-size: 13px;
            color: Theme.text-3;
            vertical-alignment: center;
            width: 46px;
            horizontal-alignment: right;
        }

        // Действия: лайк + скачать (проявляются при наведении)
        Rectangle {
            width: 76px;
            property <bool> shown: ta.has-hover || root.liked || root.dl-state > 0;
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 130ms; }
            HorizontalLayout {
                alignment: end;
                spacing: 2px;
                IconButton {
                    source: root.liked ? Icons.heart-filled : Icons.heart;
                    on: root.liked;
                    size: 28px;
                    icon-size: 17px;
                    interactive: ta.has-hover || root.liked;
                    clicked => { root.like-toggled(); }
                }
                IconButton {
                    source: root.dl-state == 2 ? Icons.check
                          : root.dl-state == 3 ? Icons.error : Icons.download;
                    on: root.dl-state == 2;
                    size: 28px;
                    icon-size: 16px;
                    interactive: ta.has-hover || root.dl-state > 0;
                    clicked => { root.download-clicked(); }
                }
            }
        }
    }
}

// ---------- Переключатель Win11 ----------
export component Toggle inherits Rectangle {
    in property <bool> checked: false;
    callback toggled;

    width: 40px; height: 20px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent-deep : Theme.fill;
    border-width: checked ? 0px : 1px;
    border-color: Theme.stroke-strong;
    animate background { duration: 120ms; }

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        width: 12px; height: 12px;
        border-radius: 6px;
        background: root.checked ? Theme.text-on-accent : Theme.text-2;
        animate x { duration: 120ms; easing: ease-out; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// ---------- Поле поиска ----------
export component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Поиск";
    callback accepted(string);

    height: 36px;
    border-radius: Theme.r-ctl;
    background: Theme.fill;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.stroke;
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 10px;
        Icon {
            source: Icons.search;
            size: 15px;
            tint: Theme.text-3;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            if root.text == "": Text {
                text: root.placeholder;
                font-size: 13.5px;
                color: Theme.text-3;
                vertical-alignment: center;
            }
            input := TextInput {
                font-size: 13.5px;
                color: Theme.text;
                vertical-alignment: center;
                accepted => { root.accepted(root.text); }
            }
        }
        if root.text != "": IconButton {
            source: Icons.close;
            size: 24px;
            icon-size: 12px;
            y: (parent.height - 24px) / 2;
            clicked => { root.text = ""; }
        }
    }
}

// ---------- Сетка плиток с переносом строк и растяжкой ----------
// Плитки фиксированного целевого размера раскладываются по строкам
// (слева направо, сверху вниз) и растягиваются, чтобы заполнить
// ширину ровно. Высота сетки — out-свойство для Flickable.
export component TileGrid inherits Rectangle {
    in property <[TileItem]> items;
    // Не ограничиваем родительские layout-ы: без явных констрейнтов
    // Rectangle с position-детьми отдаёт max-width по правому краю
    // последней карточки, и Flickable сжимается до preferred контента.
    min-width: 0px;
    max-width: 16777215px;
    preferred-width: 0px;
    in property <length> target-size: 172px;   // желаемая ширина плитки
    in property <length> gap: 18px;
    in property <int> min-cols: 2;
    callback tile-clicked(TileItem);

    // Сколько колонок влезает (не меньше min-cols).
    property <int> cols: max(min-cols,
        Math.floor((self.width + gap) / (target-size + gap)));
    // Фактическая ширина плитки: растягиваем колонки на всю ширину.
    property <length> tile-w: (self.width - gap * (cols - 1)) / cols;
    property <length> tile-h: tile-w + 46px;
    property <int> rows: items.length == 0 ? 0
        : Math.ceil(items.length / cols);

    height: rows == 0 ? 0px : rows * tile-h + (rows - 1) * gap;

    for item[i] in root.items: TileCard {
        x: Math.mod(i, cols) * (root.tile-w + root.gap);
        y: Math.floor(i / cols) * (root.tile-h + root.gap);
        tile-size: root.tile-w;
        title: item.title;
        subtitle: item.subtitle;
        cover-image: item.cover;
        cover-variant: item.cover-variant;
        clicked => { root.tile-clicked(item); }
    }
}
